u0432\u0430\u043b\u044c\u043d\u0438\u043a\u0438","Giving settings":"\u041d\u0430\u0434\u0430\u043d\u043d\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c","Go to ministry dashboard":"\u041f\u0435\u0440\u0435\u0439\u0434\u0456\u0442\u044c \u043d\u0430 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u0439\u043d\u0443 \u043f\u0430\u043d\u0435\u043b\u044c \u043c\u0456\u043d\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430","Goal ended":"\u0414\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f \u0437\u0430\u043a\u0456\u043d\u0447\u0435\u043d\u043e","Goal is created":"\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043e \u043a\u0430\u0431\u0456\u043d\u0435\u0442","Going deeper with my friends":"\u0417\u0430\u0433\u043b\u0438\u0431\u043b\u044e\u044e\u0441\u044f \u0437 \u0434\u0440\u0443\u0437\u044f\u043c\u0438","Got it":"\u0417\u0440\u043e\u0437\u0443\u043c\u0456\u0432!",Gratitude:"\u041f\u043e\u0434\u044f\u043a\u0430","Gratitude entries":"\u041f\u043e\u0434\u044f\u0447\u043d\u0456 \u0437\u0430\u043f\u0438\u0441\u0438","Gratitude entries are great ways to celebrate how God is moving":"\u041f\u043e\u0434\u044f\u0447\u043d\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u2014 \u0447\u0443\u0434\u043e\u0432\u0438\u0439 \u0441\u043f\u043e\u0441\u0456\u0431 \u0432\u0456\u0434\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0442\u0435, \u044f\u043a \u0411\u043e\u0433 \u0440\u0443\u0445\u0430\u0454\u0442\u044c\u0441\u044f","Gratitude entries \ud83c\udf89":"\u0417\u0430\u043f\u0438\u0441\u0438 \u043f\u043e\u0434\u044f\u043a\u0438 \ud83c\udf89","Gratitude journaling":"\u0412\u0435\u0434\u0435\u043d\u043d\u044f \u0449\u043e\u0434\u0435\u043d\u043d\u0438\u043a\u0430 \u043f\u043e\u0434\u044f\u043a\u0438","Gratitude prompt":"\u041f\u0456\u0434\u043a\u0430\u0437\u043a\u0430 \u043f\u043e\u0434\u044f\u043a\u0438","Gratitude shared":"\ud83c\udf89 \u041f\u043e\u0434\u044f\u043a\u0430 \u043f\u043e\u0434\u0456\u043b\u0438\u043b\u0430\u0441\u044f",Group:"\u0413\u0440\u0443\u043f\u0430","Group Prayer":"\u0413\u0440\u0443\u043f\u043e\u0432\u0430 \u043c\u043e\u043b\u0438\u0442\u0432\u0430","Group activity":"\u0413\u0440\u0443\u043f\u043e\u0432\u0430 \u0434\u0456\u044f\u043b\u044c\u043d\u0456\u0441\u0442\u044c","Group age":"\u0412\u0456\u043a \u0433\u0440\u0443\u043f\u0438","Group chat":"\u0413\u0440\u0443\u043f\u043e\u0432\u0438\u0439 \u0447\u0430\u0442","Group is created":"\u0413\u0440\u0443\u043f\u0430 \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u0430","Group is deleted":"\u0413\u0440\u0443\u043f\u0430 \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u0430!","Group is full":"\u0413\u0440\u0443\u043f\u0430 \u043f\u043e\u0432\u043d\u0430","Group members":"\u0427\u043b\u0435\u043d\u0438 \u0433\u0440\u0443\u043f\u0438","Group not found":"\u0413\u0440\u0443\u043f\u0443 \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e!","Group settings":"\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0433\u0440\u0443\u043f\u0438",Groups:"\u0413\u0440\u0443\u043f\u0438","Grow with us":"\u0417\u0440\u043e\u0441\u0442\u0430\u0439\u0442\u0435 \u0440\u0430\u0437\u043e\u043c \u0437 \u043d\u0430\u043c\u0438","Grow with us desc":"\u0429\u043e\u0431 \u043e\u0445\u043e\u043f\u0438\u0442\u0438 \u0441\u0432\u0456\u0442 \u0456 \u0432\u043f\u043b\u0438\u043d\u0443\u0442\u0438 \u043d\u0430 \u043d\u044c\u043e\u0433\u043e, \u043f\u043e\u0431\u0443\u0434\u0443\u0432\u0430\u0432\u0448\u0438 \u0432\u0435\u043b\u0438\u043a\u0443 \u0446\u0435\u0440\u043a\u0432\u0443, \u0437\u043e\u0441\u0435\u0440\u0435\u0434\u0436\u0435\u043d\u0443 \u043d\u0430 \u0425\u0440\u0438\u0441\u0442\u0456, \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d\u0443 \u043d\u0430 \u0411\u0456\u0431\u043b\u0456\u0457, \u0437\u043c\u0456\u043d\u044e\u044e\u0447\u0438 \u043c\u0438\u0441\u043b\u0435\u043d\u043d\u044f \u0442\u0430 \u043d\u0430\u0434\u0430\u044e\u0447\u0438 \u043b\u044e\u0434\u044f\u043c \u043c\u043e\u0436\u043b\u0438\u0432\u0456\u0441\u0442\u044c \u043b\u0456\u0434\u0438\u0440\u0443\u0432\u0430\u0442\u0438 \u0442\u0430 \u0432\u043f\u043b\u0438\u0432\u0430\u0442\u0438 \u0432 \u043a\u043e\u0436\u043d\u0456\u0439 \u0441\u0444\u0435\u0440\u0456 \u0436\u0438\u0442\u0442\u044f.","Grow with your community":"\u0417\u0440\u043e\u0441\u0442\u0430\u0439\u0442\u0435 \u0440\u0430\u0437\u043e\u043c \u0456\u0437 \u0441\u043e\u0431\u043e\u044e\n\u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0430 \ud83c\udf31\ufe0f","Growth Challenge":"\ud83c\udf31 \u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0437\u0440\u043e\u0441\u0442\u0430\u043d\u043d\u044f:","Growth message":"\u041f\u043e\u0434\u0443\u043c\u0430\u0439\u0442\u0435 \u043f\u0440\u043e \u0442\u0435, \u044f\u043a \u0411\u043e\u0433 \u043d\u0435\u0449\u043e\u0434\u0430\u0432\u043d\u043e \u0431\u043b\u0430\u0433\u043e\u0441\u043b\u043e\u0432\u0438\u0432 \u0432\u0430\u0441, \u0456 \u043f\u043e\u0434\u0456\u043b\u0456\u0442\u044c\u0441\u044f \u0446\u0438\u043c \u0437\u0456 \u0441\u0432\u043e\u0454\u044e \u0433\u0440\u0443\u043f\u043e\u044e \u0446\u044c\u043e\u0433\u043e \u0442\u0438\u0436\u043d\u044f \u0443 \u0437\u0430\u043f\u0438\u0441\u0456 \u043f\u043e\u0434\u044f\u043a\u0438","Have you taken action today":"\u0412\u0438 \u0432\u0436\u0438\u043b\u0438 \u0437\u0430\u0445\u043e\u0434\u0456\u0432 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456?","Help us make ministry impact":"\u0414\u043e\u043f\u043e\u043c\u043e\u0436\u0456\u0442\u044c \u043d\u0430\u043c \u0432\u043f\u043b\u0438\u0432\u0430\u0442\u0438 \u043d\u0430 \u0441\u043b\u0443\u0436\u0456\u043d\u043d\u044f!","Here are some plans org recommends using":"\u041e\u0441\u044c \u043a\u0456\u043b\u044c\u043a\u0430 \u043f\u043b\u0430\u043d\u0456\u0432, \u044f\u043a\u0456 {{orgName}} \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u2728","Here are some plans your org recommends using":"\u041e\u0441\u044c \u043a\u0456\u043b\u044c\u043a\u0430 \u043f\u043b\u0430\u043d\u0456\u0432, \u044f\u043a\u0456 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0432\u0430\u0448\u0435 \u043c\u0456\u043d\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043e \u2728",High:"\u0412\u0438\u0441\u043e\u043a\u0438\u0439",History:"\u0456\u0441\u0442\u043e\u0440\u0456\u044f",Home:"\u0434\u043e\u0434\u043e\u043c\u0443","How did you take action and what did you learn":"\u042f\u043a \u0432\u0438 \u0434\u0456\u044f\u043b\u0438 \u0456 \u0447\u043e\u0433\u043e \u043d\u0430\u0432\u0447\u0438\u043b\u0438\u0441\u044f?","How it works":"\u041e\u0441\u044c \u044f\u043a \u0446\u0435 \u043f\u0440\u0430\u0446\u044e\u0454:","How much give":"\u0421\u043a\u0456\u043b\u044c\u043a\u0438 \u0431 \u0432\u0438\n\u043f\u043e\u0434\u043e\u0431\u0430\u0454\u0442\u044c\u0441\u044f \u0434\u0430\u0440\u0443\u0432\u0430\u0442\u0438?","How much time does your group have to study each day":"\u23f0 \u0421\u043a\u0456\u043b\u044c\u043a\u0438 \u0447\u0430\u0441\u0443 \u043c\u0430\u0454 \u0432\u0430\u0448\u0430 \u0433\u0440\u0443\u043f\u0430 \u043d\u0430 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u0449\u043e\u0434\u043d\u044f?","I already have an account":"\u0423 \u043c\u0435\u043d\u0435 \u0432\u0436\u0435 \u0454 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441","I do not have a code":"\u0423 \u043c\u0435\u043d\u0435 \u043d\u0435\u043c\u0430\u0454 \u043a\u043e\u0434\u0443","I want to build a reading habit to":"\u042f \u0445\u043e\u0447\u0443...","IOS Settings":"\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f iOS","Ic Choose a book":"\ud83d\udcd6 \u041e\u0431\u0435\u0440\u0456\u0442\u044c \u043a\u043d\u0438\u0433\u0443","Ic Group settings":"\ud83d\udc46 \u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0433\u0440\u0443\u043f\u0438","Icon Gratitude entries":"\u0417\u0430\u043f\u0438\u0441\u0438 \u043f\u043e\u0434\u044f\u043a\u0438 \ud83c\udf89","Icon Prayer":"\u041c\u043e\u043b\u0438\u0442\u0432\u0438 \ud83d\ude4f","Icon Welcome to BibleDept":"\ud83d\udc4b \u041b\u0430\u0441\u043a\u0430\u0432\u043e \u043f\u0440\u043e\u0441\u0438\u043c\u043e \u0434\u043e {{org_name}}","If you d like to build a plan on  your desktop head to":"\u042f\u043a\u0449\u043e \u0432\u0438 \u0445\u043e\u0447\u0435\u0442\u0435 \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u043f\u043b\u0430\u043d \u043d\u0430 \u0440\u043e\u0431\u043e\u0447\u043e\u043c\u0443 \u0441\u0442\u043e\u043b\u0456, \u043f\u0435\u0440\u0435\u0439\u0434\u0456\u0442\u044c \u0434\u043e",In:"\u0432","Input name":"\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u043d\u0430\u0437\u0432\u0443",Insane:"\u0431\u043e\u0436\u0435\u0432\u0456\u043b\u044c\u043d\u0438\u0439","Introducing our next action step":"\u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0454\u043c\u043e \u043d\u0430\u0448 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u0439\n\u043a\u0440\u043e\u043a \u0434\u0456\u0457!","Invalid invite link":"\u041d\u0435\u0434\u0456\u0439\u0441\u043d\u0435 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u0434\u043b\u044f \u0437\u0430\u043f\u0440\u043e\u0448\u0435\u043d\u043d\u044f!","Invalid link":"\u041d\u0435\u0434\u0456\u0439\u0441\u043d\u0435 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f",Invite:"\u0417\u0430\u043f\u0440\u043e\u0441\u0438\u0442\u0438","Invite a friend":"\u0417\u0430\u043f\u0440\u043e\u0441\u0456\u0442\u044c \u0434\u0440\u0443\u0433\u0430","Invite code is not valid":"\u041a\u043e\u0434 \u0437\u0430\u043f\u0440\u043e\u0448\u0435\u043d\u043d\u044f \u043d\u0435\u0434\u0456\u0439\u0441\u043d\u0438\u0439!","Invite friends to BibleDept":"\u0417\u0430\u043f\u0440\u043e\u0441\u0456\u0442\u044c \u0434\u0440\u0443\u0437\u0456\u0432 \u0434\u043e {{org_name}}","Invite members":"\u0417\u0430\u043f\u0440\u043e\u0441\u0438\u0442\u0438 \u0443\u0447\u0430\u0441\u043d\u0438\u043a\u0456\u0432","Invite your friends":"\u0417\u0430\u043f\u0440\u043e\u0448\u0443\u0439\u0442\u0435 \u0434\u0440\u0443\u0437\u0456\u0432\u2728\ufe0f","Invite your friends ":"\u0417\u0430\u043f\u0440\u043e\u0448\u0443\u0439\u0442\u0435 \u0434\u0440\u0443\u0437\u0456\u0432!","Is there someone in your life the group can be praying for":"\u0427\u0438 \u0454 \u0445\u0442\u043e\u0441\u044c \u0443 \u0432\u0430\u0448\u043e\u043c\u0443 \u0436\u0438\u0442\u0442\u0456, \u0437\u0430 \u043a\u043e\u0433\u043e \u0433\u0440\u0443\u043f\u0430 \u043c\u043e\u0436\u0435 \u043c\u043e\u043b\u0438\u0442\u0438\u0441\u044f?","Is there someone in your life we can be praying for":"\u0427\u0438 \u0454 \u0445\u0442\u043e\u0441\u044c \u0443 \u0432\u0430\u0448\u043e\u043c\u0443 \u0436\u0438\u0442\u0442\u0456, \u0437\u0430 \u043a\u043e\u0433\u043e \u043c\u0438 \u043c\u043e\u0436\u0435\u043c\u043e \u043c\u043e\u043b\u0438\u0442\u0438\u0441\u044f?","Is there something going on in the world you d like to pray for":"\u0427\u0438 \u0454 \u0449\u043e\u0441\u044c \u0443 \u0441\u0432\u0456\u0442\u0456, \u043f\u0440\u043e \u0449\u043e \u0432\u0438 \u0445\u043e\u0442\u0456\u043b\u0438 \u0431 \u043c\u043e\u043b\u0438\u0442\u0438\u0441\u044f?","Is there something going on in the world youd like to pray for":"\u0427\u0438 \u0454 \u0449\u043e\u0441\u044c \u0443 \u0441\u0432\u0456\u0442\u0456, \u043f\u0440\u043e \u0449\u043e \u0432\u0438 \u0445\u043e\u0442\u0456\u043b\u0438 \u0431 \u043f\u043e\u043c\u043e\u043b\u0438\u0442\u0438\u0441\u044f?","It is time to plan your next study":"\u041d\u0430\u0441\u0442\u0430\u0432 \u0447\u0430\u0441 \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u0442\u0438 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0435 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f!","Join Group":"\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0442\u0438\u0441\u044c \u0434\u043e \u0433\u0440\u0443\u043f\u0438","Join a group":"\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0442\u0438\u0441\u044f \u0434\u043e \u0433\u0440\u0443\u043f\u0438","Join with code":"\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0442\u0438\u0441\u044f \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u043a\u043e\u0434\u0443","Jump in":"\u0421\u0442\u0440\u0438\u0431\u0430\u0442\u0438","Just checking":"\u041f\u0440\u043e\u0441\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u044f\u044e!","Just trying it out":"\u041f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u043e\u0431\u0443\u044e","Kate responded to your prayer request":{" Tap to view":"\u041a\u0435\u0439\u0442 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u043b\u0430 \u043d\u0430 \u0432\u0430\u0448\u0435 \u043c\u043e\u043b\u0438\u0442\u043e\u0432\u043d\u0435 \u043f\u0440\u043e\u0445\u0430\u043d\u043d\u044f! \u0422\u043e\u0440\u043a\u043d\u0456\u0442\u044c\u0441\u044f, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \ud83d\ude4f"},"Keep doing what you":"\u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0443\u0439\u0442\u0435 \u0440\u043e\u0431\u0438\u0442\u0438 \u0442\u0435, \u0449\u043e \u0432\u0438 \u0440\u043e\u0431\u0438\u0442\u0435!","Keep doing what you re doing":"\u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0443\u0439\u0442\u0435 \u0440\u043e\u0431\u0438\u0442\u0438 \u0442\u0435, \u0449\u043e \u0432\u0438 \u0440\u043e\u0431\u0438\u0442\u0435","Keep follow up up":"\u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0443\u0439\u0442\u0435 \u0441\u0442\u0435\u0436\u0438\u0442\u0438","Keep the momentum going by reading and engaging with your group daily":"\u041f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0439\u0442\u0435 \u0456\u043c\u043f\u0443\u043b\u044c\u0441, \u0447\u0438\u0442\u0430\u044e\u0447\u0438 \u0442\u0430 \u0441\u043f\u0456\u043b\u043a\u0443\u044e\u0447\u0438\u0441\u044c \u0437\u0456 \u0441\u0432\u043e\u0454\u044e \u0433\u0440\u0443\u043f\u043e\u044e \u0449\u043e\u0434\u043d\u044f!",Language:"\u041c\u043e\u0432\u0443",Leader:"\u041b\u0456\u0434\u0435\u0440","Leader tools":"\u0406\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438 \u043b\u0456\u0434\u0435\u0440\u0430","Leader tools with ic":"\u0406\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438 \u043b\u0456\u0434\u0435\u0440\u0430 \ud83d\udd27","Leading a group can be overwhelming":"\u041e\u0447\u043e\u043b\u044e\u0432\u0430\u0442\u0438 \u0433\u0440\u0443\u043f\u0443 \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u043d\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043d\u043e \u0432\u0430\u0436\u043a\u043e,\n\u0430\u043b\u0435 \u043c\u0438 \u0437\u0440\u043e\u0431\u0438\u043c\u043e \u0446\u0435 \u043b\u0435\u0433\u043a\u043e \ud83d\udc4c","Learn more":"\u0412\u0438\u0432\u0447\u0430\u0439\u0442\u0435 \u0431\u0456\u043b\u044c\u0448\u0435","Leave group":"\u041f\u043e\u043a\u0438\u043d\u0443\u0442\u0438 \u0433\u0440\u0443\u043f\u0443","Left group":"\u041b\u0456\u0432\u0430 \u0433\u0440\u0443\u043f\u0430!","Let BibleDept create a smart study plan with engaging activities and discussion":"\u0414\u043e\u0437\u0432\u043e\u043b\u044c\u0442\u0435 {{org_name}} \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0440\u043e\u0437\u0443\u043c\u043d\u0438\u0439 \u043f\u043b\u0430\u043d \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u0456\u0437 \u0437\u0430\u0445\u043e\u043f\u043b\u044e\u044e\u0447\u0438\u043c\u0438 \u0437\u0430\u0445\u043e\u0434\u0430\u043c\u0438 \u0442\u0430 \u043f\u0456\u0434\u043a\u0430\u0437\u043a\u0430\u043c\u0438 \u0434\u043b\u044f \u043e\u0431\u0433\u043e\u0432\u043e\u0440\u0435\u043d\u043d\u044f, \u0430\u0434\u0430\u043f\u0442\u043e\u0432\u0430\u043d\u0438\u043c\u0438 \u0434\u043b\u044f \u0432\u0430\u0448\u043e\u0457 \u0433\u0440\u0443\u043f\u0438","Let BibleDept create a smart study plan with engaging activities and discussion prompts tailored for your specific group":"\u0414\u043e\u0437\u0432\u043e\u043b\u044c\u0442\u0435 {{org_name}} \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0440\u043e\u0437\u0443\u043c\u043d\u0438\u0439 \u043d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u0438\u0439 \u043f\u043b\u0430\u043d \u0456\u0437 \u0446\u0456\u043a\u0430\u0432\u0438\u043c\u0438 \u0437\u0430\u0445\u043e\u0434\u0430\u043c\u0438 \u0442\u0430 \u043f\u0456\u0434\u043a\u0430\u0437\u043a\u0430\u043c\u0438 \u0434\u043b\u044f \u043e\u0431\u0433\u043e\u0432\u043e\u0440\u0435\u043d\u043d\u044f, \u0430\u0434\u0430\u043f\u0442\u043e\u0432\u0430\u043d\u0438\u043c\u0438 \u0434\u043b\u044f \u0432\u0430\u0448\u043e\u0457 \u0433\u0440\u0443\u043f\u0438.","Let s do this":"\u0414\u0430\u0432\u0430\u0439 \u0437\u0440\u043e\u0431\u0438\u043c\u043e \u0446\u0435!","Let s get you into your group":"\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0437\u0430\u0432\u0435\u0434\u0435\u043c\u043e \u0432\u0430\u0441 \u0443 \u0432\u0430\u0448\u0443 \u0433\u0440\u0443\u043f\u0443! \ud83d\udc4c","Let s jump in":"\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0441\u0442\u0440\u0438\u0431\u0430\u0442\u0438!","Link accounts":"\u041f\u043e\u0432\u2019\u044f\u0437\u0430\u0442\u0438 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0456 \u0437\u0430\u043f\u0438\u0441\u0438","Link accounts description":"\u0421\u0445\u043e\u0436\u0435, \u0432\u0438 \u0432\u0432\u0456\u0439\u0448\u043b\u0438 \u0432 {{appNameValue}}, \u043f\u0435\u0440\u0448 \u043d\u0456\u0436 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 Google \u0437 {{emailValue}}. \u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \xab\u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438\xbb \u043d\u0438\u0436\u0447\u0435, \u0449\u043e\u0431 \u0443\u0432\u0456\u0439\u0442\u0438 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0442\u0430 \u043f\u043e\u0432\u2019\u044f\u0437\u0430\u0442\u0438 \u0441\u0432\u043e\u0457 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0456 \u0437\u0430\u043f\u0438\u0441\u0438.","Log out":"\u0412\u0438\u0439\u0442\u0438",Login:"\u041b\u043e\u0433\u0456\u043d","Login to delete account":"\u0423\u0432\u0456\u0439\u0434\u0456\u0442\u044c, \u0449\u043e\u0431 \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441","Long-term believers going deeper":"\u0414\u043e\u0432\u0433\u043e\u0441\u0442\u0440\u043e\u043a\u043e\u0432\u0456 \u0432\u0456\u0440\u0443\u044e\u0447\u0456 \u0437\u0430\u0433\u043b\u0438\u0431\u043b\u044e\u044e\u0442\u044c\u0441\u044f","Looks good to me":"\u041c\u0435\u043d\u0456 \u0432\u0438\u0433\u043b\u044f\u0434\u0430\u0454 \u0434\u043e\u0431\u0440\u0435","Looks good to me ":"\u041c\u0435\u043d\u0456 \u0434\u043e\u0431\u0440\u0435 \u0432\u0438\u0433\u043b\u044f\u0434\u0430\u0454!","Looks like your next group study needs to be set":"\u0417\u0434\u0430\u0454\u0442\u044c\u0441\u044f, \u0432\u0430\u0448\u0435 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0435 \u0433\u0440\u0443\u043f\u043e\u0432\u0435 \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f\n\u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438...",Low:"\u041d\u0438\u0437\u044c\u043a\u0438\u0439",MMYY:"\u041c\u041c/\u0420\u0420","MY PLANS":"\u041c\u041e\u0407 \u041f\u041b\u0410\u041d\u0418","Mark all as read":"\u041f\u043e\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0432\u0441\u0435 \u044f\u043a \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043d\u0435","Mark as complete":"\u041f\u043e\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u044f\u043a \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0435","Mark as read":"\u041f\u043e\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u044f\u043a \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043d\u0435","Mark as watched":"\u041f\u043e\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u044f\u043a \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0435","Maybe later":"\u041c\u043e\u0436\u043b\u0438\u0432\u043e \u043f\u0456\u0437\u043d\u0456\u0448\u0435","Member removed":"\u0423\u0447\u0430\u0441\u043d\u0438\u043a\u0430 \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043e",Members:"\u0427\u043b\u0435\u043d\u0438",Menu:"\u041c\u0435\u043d\u044e","Message sent":"\u041f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u043d\u043e","Messages sent":"\ud83d\udcac \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u043d\u043e","Missing the action text":"\u0412\u0456\u0434\u0441\u0443\u0442\u043d\u0456\u0439 \u0442\u0435\u043a\u0441\u0442 \u0434\u0456\u0457","More people":"\u0411\u0456\u043b\u044c\u0448\u0435 \u043b\u044e\u0434\u0435\u0439, \u0431\u0456\u043b\u044c\u0448\u0435 \u0441\u0445\u043e\u0436\u0438\u0445 \u043d\u0430 \u0406\u0441\u0443\u0441\u0430","More people desc":"\u041d\u0430\u0448\u0430 \u043c\u0435\u0442\u0430 \u2014 \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0434\u0443\u0445\u043e\u0432\u043d\u0456 \u0440\u043e\u0437\u043c\u043e\u0432\u0438, \u044f\u043a\u0456 \u0437\u2019\u0454\u0434\u043d\u0443\u044e\u0442\u044c \u043b\u044e\u0434\u0435\u0439 \u043e\u0434\u0438\u043d \u0437 \u043e\u0434\u043d\u0438\u043c \u0456 \u0441\u0432\u0456\u0442\u043e\u043c.","Mute notifications":"\u0412\u0438\u043c\u043a\u043d\u0443\u0442\u0438 \u0441\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f","My Bible study":"\u041c\u043e\u0454 \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f \u0411\u0456\u0431\u043b\u0456\u0457","My daily Bible study":"\u041c\u043e\u0454 \u0449\u043e\u0434\u0435\u043d\u043d\u0435 \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f \u0411\u0456\u0431\u043b\u0456\u0457","NO THANKS":"\u041d\u0406, \u0414\u042f\u041a\u0423\u042e",Name:"\u0406\u043c'\u044f","Name on card":"\u0406\u043c'\u044f \u043d\u0430 \u043a\u0430\u0440\u0442\u0446\u0456","Name, You have been invited to":"{{nameValue}}, \u0432\u0430\u0441 \u0437\u0430\u043f\u0440\u043e\u0441\u0438\u043b\u0438","Navigate to whats next by tapping on sides of the screen":"\u041f\u0435\u0440\u0435\u0439\u0434\u0456\u0442\u044c \u0434\u043e \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u043e\u0433\u043e, \u0442\u043e\u0440\u043a\u0430\u044e\u0447\u0438\u0441\u044c \u0431\u043e\u043a\u0456\u0432 \u0435\u043a\u0440\u0430\u043d\u0430","Navigators plan":"\u041f\u043b\u0430\u043d \u043d\u0430\u0432\u0456\u0433\u0430\u0442\u043e\u0440\u0456\u0432","Never miss out":"\u041d\u0456\u043a\u043e\u043b\u0438 \u043d\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0456\u0442\u044c!","New believers or non-believers":"\u041d\u043e\u0432\u0456 \u0432\u0456\u0440\u0443\u044e\u0447\u0456 \u0447\u0438 \u043d\u0435\u0432\u0456\u0440\u0443\u044e\u0447\u0456","New message":"\u041d\u043e\u0432\u0435 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f","NewLife church connects personally with members through text for important info":"{{orgName}} \u043e\u0441\u043e\u0431\u0438\u0441\u0442\u043e \u0441\u043f\u0456\u043b\u043a\u0443\u0454\u0442\u044c\u0441\u044f \u0437 \u0447\u043b\u0435\u043d\u0430\u043c\u0438 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u0438\u0445 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u044c, \u0449\u043e\u0431 \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0432\u0430\u0436\u043b\u0438\u0432\u0443 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e",Next:"\u0414\u0430\u043b\u0456",No:"\u041d\u0456","No code desc":"\u042f\u043a\u0449\u043e \u0432\u0430\u0441 \u0437\u0430\u043f\u0440\u043e\u0441\u0438\u043b\u0438 \u0437\u0430 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f\u043c, \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0438\u0439\u0434\u0456\u0442\u044c \u0456\u0437 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u0442\u0430 \u0437\u043d\u043e\u0432\u0443 \u0442\u043e\u0440\u043a\u043d\u0456\u0442\u044c\u0441\u044f \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u0437\u0430\u043f\u0440\u043e\u0448\u0435\u043d\u043d\u044f, \u0449\u043e\u0431 \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0441\u0432\u043e\u0454\u0457 \u0433\u0440\u0443\u043f\u0438 \ud83d\udc4c","No code no problem":"\u041d\u0435\u043c\u0430\u0454 \u043a\u043e\u0434\u0443, \u043d\u0435\u043c\u0430\u0454 \u043f\u0440\u043e\u0431\u043b\u0435\u043c!","No giving":"\u0411\u0435\u0437 \u043d\u0430\u0434\u0430\u043d\u043d\u044f","No groups":"\u041d\u0435\u043c\u0430\u0454 \u0433\u0440\u0443\u043f","No new action steps":"\u041d\u0456\u044f\u043a\u0438\u0445 \u043d\u043e\u0432\u0438\u0445 \u043a\u0440\u043e\u043a\u0456\u0432","No new entries":"\u041d\u0435\u043c\u0430\u0454 \u043d\u043e\u0432\u0438\u0445 \u0437\u0430\u043f\u0438\u0441\u0456\u0432","No new prayers":"\u041d\u0435\u043c\u0430\u0454 \u043d\u043e\u0432\u0438\u0445 \u043c\u043e\u043b\u0438\u0442\u043e\u0432","No new study discussions":"\u041d\u0435\u043c\u0430\u0454 \u043d\u043e\u0432\u0438\u0445 \u043e\u0431\u0433\u043e\u0432\u043e\u0440\u0435\u043d\u044c \u0449\u043e\u0434\u043e \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f","No passages before":"\u0414\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u043f\u0438\u0442\u0430\u043d\u043d\u044f \u043d\u0435\u043c\u0430\u0454 \u043f\u0440\u043e\u0445\u043e\u0434\u0443.","No thanks":"\u041d\u0456, \u0434\u044f\u043a\u0443\u044e","Not a member of any group":"\u0412\u0438 \u043d\u0435 \u0454 \u0443\u0447\u0430\u0441\u043d\u0438\u043a\u043e\u043c \u0436\u043e\u0434\u043d\u043e\u0457 \u0433\u0440\u0443\u043f\u0438, \u043f\u0440\u0438\u0454\u0434\u043d\u0430\u0439\u0442\u0435\u0441\u044f \u0430\u0431\u043e \u0441\u0442\u0432\u043e\u0440\u0456\u0442\u044c \u0457\u0457 \u043d\u0438\u0436\u0447\u0435","Not found QR Code":"QR-\u043a\u043e\u0434 \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e","Not found email":"\u042f \u043d\u0435 \u043e\u0442\u0440\u0438\u043c\u0430\u0432 \u043b\u0438\u0441\u0442\u0430","Not now":"\u041d\u0435 \u0437\u0430\u0440\u0430\u0437","Not yet":"\u0429\u0435 \u043d\u0456","Notifications muted":"\u0421\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e","Notifications unmuted":"\u0421\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f \u0432\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e",OK:"\u0432 \u043f\u043e\u0440\u044f\u0434\u043a\u0443","Only allow one gratitude activity in a day":"\u0414\u043e\u0437\u0432\u043e\u043b\u044f\u0439\u0442\u0435 \u043b\u0438\u0448\u0435 \u043e\u0434\u043d\u0443 \u043f\u043e\u0434\u044f\u043a\u0443 \u043d\u0430 \u0434\u0435\u043d\u044c","Only allow one prayer activity in a day":"\u0414\u043e\u0437\u0432\u043e\u043b\u044f\u0439\u0442\u0435 \u043b\u0438\u0448\u0435 \u043e\u0434\u043d\u0443 \u043c\u043e\u043b\u0438\u0442\u043e\u0432\u043d\u0443 \u0434\u0456\u044f\u043b\u044c\u043d\u0456\u0441\u0442\u044c \u043d\u0430 \u0434\u0435\u043d\u044c",Open:"\u0412\u0406\u0414\u0427\u0418\u041d\u0415\u041d\u041e","Open group":"\u0412\u0456\u0434\u043a\u0440\u0438\u0442\u0430 \u0433\u0440\u0443\u043f\u0430","Open study plan":"\u0412\u0456\u0434\u043a\u0440\u0438\u0442\u0438\u0439 \u043f\u043b\u0430\u043d \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f","Or build your own plan":"\u0410\u0431\u043e \u0441\u0442\u0432\u043e\u0440\u0456\u0442\u044c \u0432\u043b\u0430\u0441\u043d\u0438\u0439 \u043f\u043b\u0430\u043d","Organisation not found":"\u041e\u0440\u0433\u0430\u043d\u0456\u0437\u0430\u0446\u0456\u044f \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u0430!",PRAYER:"\u041c\u041e\u041b\u0418\u0422\u0412\u0410",Passage:"\u043f\u0440\u043e\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f","Paste video link":"\u0412\u0441\u0442\u0430\u0432\u0442\u0435 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u043d\u0430 \u0432\u0456\u0434\u0435\u043e","Paste your invite link below to join an existing group":"\u0412\u0441\u0442\u0430\u0432\u0442\u0435 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u0434\u043b\u044f \u