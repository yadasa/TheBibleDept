43d\u0438\u043a\u0438 \u0433\u0440\u0443\u043f\u043f\u044b","Group not found":"\u0413\u0440\u0443\u043f\u043f\u0430 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u0430!","Group settings":"\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0433\u0440\u0443\u043f\u043f\u044b",Groups:"\u0413\u0440\u0443\u043f\u043f\u044b","Grow with us":"\u0420\u0430\u0441\u0442\u0438 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u043d\u0430\u043c\u0438","Grow with us desc":"\u0414\u043e\u0441\u0442\u0443\u0447\u0430\u0442\u044c\u0441\u044f \u0434\u043e \u043c\u0438\u0440\u0430 \u0438 \u0432\u043b\u0438\u044f\u0442\u044c \u043d\u0430 \u043d\u0435\u0433\u043e, \u0441\u0442\u0440\u043e\u044f \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0446\u0435\u0440\u043a\u043e\u0432\u044c, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0443\u044e \u043d\u0430 \u0411\u0438\u0431\u043b\u0438\u0438, \u0432 \u0446\u0435\u043d\u0442\u0440\u0435 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0425\u0440\u0438\u0441\u0442\u043e\u0441, \u043c\u0435\u043d\u044f\u044f \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0435 \u0438 \u0434\u0430\u0432\u0430\u044f \u043b\u044e\u0434\u044f\u043c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u0438 \u0432\u043b\u0438\u044f\u0442\u044c \u043d\u0430 \u0432\u0441\u0435 \u0441\u0444\u0435\u0440\u044b \u0436\u0438\u0437\u043d\u0438.","Grow with your community":"\u0420\u0430\u0441\u0442\u0438 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441\u043e \u0441\u0432\u043e\u0438\u043c\n\u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \ud83c\udf31\ufe0f","Growth Challenge":"\ud83c\udf31 \u0412\u044b\u0437\u043e\u0432 \u0440\u043e\u0441\u0442\u0430:","Growth message":"\u041f\u043e\u0434\u0443\u043c\u0430\u0439\u0442\u0435 \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u0411\u043e\u0433 \u043d\u0435\u0434\u0430\u0432\u043d\u043e \u0431\u043b\u0430\u0433\u043e\u0441\u043b\u043e\u0432\u0438\u043b \u0432\u0430\u0441, \u0438 \u043f\u043e\u0434\u0435\u043b\u0438\u0442\u0435\u0441\u044c \u044d\u0442\u0438\u043c \u0441\u043e \u0441\u0432\u043e\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u043e\u0439 \u043d\u0430 \u044d\u0442\u043e\u0439 \u043d\u0435\u0434\u0435\u043b\u0435 \u0432 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0437\u0430\u043f\u0438\u0441\u0438.","Have you taken action today":"\u0412\u044b \u043f\u0440\u0438\u043d\u044f\u043b\u0438 \u043c\u0435\u0440\u044b \u0441\u0435\u0433\u043e\u0434\u043d\u044f?","Help us make ministry impact":"\u041f\u043e\u043c\u043e\u0433\u0438\u0442\u0435 \u043d\u0430\u043c \u043f\u043e\u0432\u043b\u0438\u044f\u0442\u044c \u043d\u0430 \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u0435!","Here are some plans org recommends using":"\u0412\u043e\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u043b\u0430\u043d\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 {{orgName}} \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u2728","Here are some plans your org recommends using":"\u0412\u043e\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u043b\u0430\u043d\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u0430\u0448\u0435 \u043c\u0438\u043d\u0438\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u2728",High:"\u0412\u044b\u0441\u043e\u043a\u0430\u044f",History:"\u0418\u0441\u0442\u043e\u0440\u0438\u044f",Home:"\u0414\u043e\u043c","How did you take action and what did you learn":"\u041a\u0430\u043a \u0432\u044b \u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u0438 \u0447\u0435\u043c\u0443 \u043d\u0430\u0443\u0447\u0438\u043b\u0438\u0441\u044c?","How it works":"\u0412\u043e\u0442 \u043a\u0430\u043a \u044d\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442:","How much give":"\u0421\u043a\u043e\u043b\u044c\u043a\u043e \u0431\u044b \u0432\u044b\n\u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f \u0434\u0430\u0440\u0438\u0442\u044c?","How much time does your group have to study each day":"\u23f0 \u0421\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0443 \u0432\u0430\u0448\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u044b \u0435\u0441\u0442\u044c \u043d\u0430 \u0437\u0430\u043d\u044f\u0442\u0438\u044f \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c?","I already have an account":"\u0443 \u043c\u0435\u043d\u044f \u0443\u0436\u0435 \u0435\u0441\u0442\u044c \u0430\u043a\u043a\u0430\u0443\u043d\u0442","I do not have a code":"\u0443 \u043c\u0435\u043d\u044f \u043d\u0435\u0442 \u043a\u043e\u0434\u0430","I want to build a reading habit to":"\u042f \u0445\u043e\u0447\u0443...","IOS Settings":"\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 iOS","Ic Choose a book":"\ud83d\udcd6 \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043a\u043d\u0438\u0433\u0443","Ic Group settings":"\ud83d\udc46 \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0433\u0440\u0443\u043f\u043f\u044b","Icon Gratitude entries":"\u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0437\u0430\u043f\u0438\u0441\u0438 \ud83c\udf89","Icon Prayer":"\u041c\u043e\u043b\u0438\u0442\u0432\u044b \ud83d\ude4f","Icon Welcome to BibleDept":"\ud83d\udc4b \u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0432 {{org_name}}","If you d like to build a plan on  your desktop head to":"\u0415\u0441\u043b\u0438 \u0432\u044b \u0445\u043e\u0442\u0438\u0442\u0435 \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u043f\u043b\u0430\u043d \u043d\u0430 \u0440\u0430\u0431\u043e\u0447\u0435\u043c \u0441\u0442\u043e\u043b\u0435, \u043f\u0435\u0440\u0435\u0439\u0434\u0438\u0442\u0435 \u043d\u0430",In:"\u0412","Input name":"\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0438\u043c\u044f",Insane:"\u0411\u0435\u0437\u0443\u043c\u043d\u044b\u0439","Introducing our next action step":"\u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u043c \u043d\u0430\u0448 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439\n\u0448\u0430\u0433 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f!","Invalid invite link":"\u041d\u0435\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0441\u0441\u044b\u043b\u043a\u0430 \u0434\u043b\u044f \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044f!","Invalid link":"\u041d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0430\u044f \u0441\u0441\u044b\u043b\u043a\u0430",Invite:"\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0430\u0442\u044c","Invite a friend":"\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u044c \u0434\u0440\u0443\u0433\u0430","Invite code is not valid":"\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043a\u043e\u0434 \u043d\u0435\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u0435\u043d!","Invite friends to BibleDept":"\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u0435 \u0434\u0440\u0443\u0437\u0435\u0439 \u0432 {{org_name}}","Invite members":"\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u044c \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432","Invite your friends":"\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0430\u0439\u0442\u0435 \u0434\u0440\u0443\u0437\u0435\u0439 \u2728\ufe0f","Invite your friends ":"\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u044c \u0441\u0432\u043e\u0438\u0445 \u0434\u0440\u0443\u0437\u0435\u0439!","Is there someone in your life the group can be praying for":"\u0415\u0441\u0442\u044c \u043b\u0438 \u0432 \u0432\u0430\u0448\u0435\u0439 \u0436\u0438\u0437\u043d\u0438 \u043a\u0442\u043e-\u0442\u043e, \u0437\u0430 \u043a\u043e\u0433\u043e \u0433\u0440\u0443\u043f\u043f\u0430 \u043c\u043e\u0436\u0435\u0442 \u043c\u043e\u043b\u0438\u0442\u044c\u0441\u044f?","Is there someone in your life we can be praying for":"\u0415\u0441\u0442\u044c \u043b\u0438 \u0432 \u0432\u0430\u0448\u0435\u0439 \u0436\u0438\u0437\u043d\u0438 \u043a\u0442\u043e-\u0442\u043e, \u0437\u0430 \u043a\u043e\u0433\u043e \u043c\u044b \u043c\u043e\u0436\u0435\u043c \u043c\u043e\u043b\u0438\u0442\u044c\u0441\u044f?","Is there something going on in the world you d like to pray for":"\u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u043b\u0438 \u0447\u0442\u043e-\u0442\u043e \u0432 \u043c\u0438\u0440\u0435, \u043e \u0447\u0435\u043c \u0432\u044b \u0445\u043e\u0442\u0435\u043b\u0438 \u0431\u044b \u043f\u043e\u043c\u043e\u043b\u0438\u0442\u044c\u0441\u044f?","Is there something going on in the world youd like to pray for":"\u041f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u043b\u0438 \u0447\u0442\u043e-\u0442\u043e \u0432 \u043c\u0438\u0440\u0435, \u043e \u0447\u0435\u043c \u0432\u044b \u0445\u043e\u0442\u0435\u043b\u0438 \u0431\u044b \u043f\u043e\u043c\u043e\u043b\u0438\u0442\u044c\u0441\u044f?","It is time to plan your next study":"\u041f\u0440\u0438\u0448\u043b\u043e \u0432\u0440\u0435\u043c\u044f \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435!","Join Group":"\u0412\u0441\u0442\u0443\u043f\u0438\u0442\u044c \u0432 \u0433\u0440\u0443\u043f\u043f\u0443","Join a group":"\u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u044c\u0441\u044f \u043a \u0433\u0440\u0443\u043f\u043f\u0435","Join with code":"\u041f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u044c\u0441\u044f \u0441 \u043a\u043e\u0434\u043e\u043c","Jump in":"\u041f\u0435\u0440\u0435\u0439\u0442\u0438 \u0432","Just checking":"\u041f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430!","Just trying it out":"\u041f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u043e\u0431\u0443\u044e","Kate responded to your prayer request":{" Tap to view":"\u041a\u0430\u0442\u044f \u043e\u0442\u043a\u043b\u0438\u043a\u043d\u0443\u043b\u0430\u0441\u044c \u043d\u0430 \u0432\u0430\u0448\u0443 \u043c\u043e\u043b\u0438\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u043f\u0440\u043e\u0441\u044c\u0431\u0443! \u041d\u0430\u0436\u043c\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \ud83d\ude4f"},"Keep doing what you":"\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0439 \u0434\u0435\u043b\u0430\u0442\u044c \u0442\u043e, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0448\u044c!","Keep doing what you re doing":"\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0439 \u0434\u0435\u043b\u0430\u0442\u044c \u0442\u043e, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0448\u044c","Keep follow up up":"\u0421\u043b\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u043d\u043e\u0432\u043e\u0441\u0442\u044f\u043c\u0438","Keep the momentum going by reading and engaging with your group daily":"\u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u0438\u043c\u043f\u0443\u043b\u044c\u0441, \u0447\u0438\u0442\u0430\u044f \u0438 \u043e\u0431\u0449\u0430\u044f\u0441\u044c \u0441\u043e \u0441\u0432\u043e\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u043e\u0439 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e!",Language:"\u042f\u0437\u044b\u043a",Leader:"\u041b\u0438\u0434\u0435\u0440","Leader tools":"\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b \u043b\u0438\u0434\u0435\u0440\u0430","Leader tools with ic":"\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b \u043b\u0438\u0434\u0435\u0440\u0430 \ud83d\udd27","Leading a group can be overwhelming":"\u041b\u0438\u0434\u0435\u0440\u0441\u0442\u0432\u043e \u0432 \u0433\u0440\u0443\u043f\u043f\u0435 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043e\u0448\u0435\u043b\u043e\u043c\u043b\u044f\u044e\u0449\u0438\u043c,\n\u043d\u043e \u043c\u044b \u0443\u043f\u0440\u043e\u0441\u0442\u0438\u043c \ud83d\udc4c","Learn more":"\u0423\u0447\u0438\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435","Leave group":"\u041f\u043e\u043a\u0438\u043d\u0443\u0442\u044c \u0433\u0440\u0443\u043f\u043f\u0443","Left group":"\u041f\u043e\u043a\u0438\u043d\u0443\u043b \u0433\u0440\u0443\u043f\u043f\u0443!","Let BibleDept create a smart study plan with engaging activities and discussion":"\u041f\u043e\u0437\u0432\u043e\u043b\u044c\u0442\u0435 {{org_name}} \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u043f\u0440\u043e\u0434\u0443\u043c\u0430\u043d\u043d\u044b\u0439 \u0443\u0447\u0435\u0431\u043d\u044b\u0439 \u043f\u043b\u0430\u043d \u0441 \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u0437\u0430\u0434\u0430\u043d\u0438\u044f\u043c\u0438 \u0438 \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0430\u043c\u0438 \u0434\u043b\u044f \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f, \u0430\u0434\u0430\u043f\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c\u0438 \u0434\u043b\u044f \u0432\u0430\u0448\u0435\u0439 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u044b.","Let BibleDept create a smart study plan with engaging activities and discussion prompts tailored for your specific group":"\u041f\u043e\u0437\u0432\u043e\u043b\u044c\u0442\u0435 {{org_name}} \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u043f\u0440\u043e\u0434\u0443\u043c\u0430\u043d\u043d\u044b\u0439 \u0443\u0447\u0435\u0431\u043d\u044b\u0439 \u043f\u043b\u0430\u043d \u0441 \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u0437\u0430\u043d\u044f\u0442\u0438\u044f\u043c\u0438 \u0438 \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0430\u043c\u0438 \u0434\u043b\u044f \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f, \u0430\u0434\u0430\u043f\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c\u0438 \u0434\u043b\u044f \u0432\u0430\u0448\u0435\u0439 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u044b.","Let s do this":"\u0414\u0430\u0432\u0430\u0439 \u0441\u0434\u0435\u043b\u0430\u0435\u043c \u044d\u0442\u043e!","Let s get you into your group":"\u041f\u0440\u0438\u043c\u0435\u043c \u0442\u0435\u0431\u044f \u0432 \u0441\u0432\u043e\u044e \u0433\u0440\u0443\u043f\u043f\u0443! \ud83d\udc4c","Let s jump in":"\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u043f\u0440\u044b\u0433\u0430\u0442\u044c!","Link accounts":"\u0421\u0432\u044f\u0437\u0430\u0442\u044c \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u044b","Link accounts description":"\u041f\u043e\u0445\u043e\u0436\u0435, \u0432\u044b \u0432\u043e\u0448\u043b\u0438 \u0432 {{appNameValue}} \u043f\u0435\u0440\u0435\u0434 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c Google \u0441 {{emailValue}}. \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \xab\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c\xbb \u043d\u0438\u0436\u0435, \u0447\u0442\u043e\u0431\u044b \u0432\u043e\u0439\u0442\u0438 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0438 \u0441\u0432\u044f\u0437\u0430\u0442\u044c \u0441\u0432\u043e\u0438 \u0443\u0447\u0435\u0442\u043d\u044b\u0435 \u0437\u0430\u043f\u0438\u0441\u0438.","Log out":"\u0412\u044b\u0439\u0442\u0438",Login:"\u0410\u0432\u0442\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f","Login to delete account":"\u0412\u043e\u0439\u0434\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0443\u0434\u0430\u043b\u0438\u0442\u044c \u0430\u043a\u043a\u0430\u0443\u043d\u0442","Long-term believers going deeper":"\u0414\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u044b\u0435 \u0432\u0435\u0440\u0443\u044e\u0449\u0438\u0435 \u0438\u0434\u0443\u0442 \u0433\u043b\u0443\u0431\u0436\u0435","Looks good to me":"\u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u0445\u043e\u0440\u043e\u0448\u043e \u0434\u043b\u044f \u043c\u0435\u043d\u044f","Looks good to me ":"\u0412\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u0445\u043e\u0440\u043e\u0448\u043e \u0434\u043b\u044f \u043c\u0435\u043d\u044f!","Looks like your next group study needs to be set":"\u041f\u043e\u0445\u043e\u0436\u0435, \u0432\u0430\u0448\u0435 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0435 \u0433\u0440\u0443\u043f\u043f\u043e\u0432\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\u043d\u0443\u0436\u043d\u043e \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c...",Low:"\u041d\u0438\u0437\u043a\u0438\u0439",MMYY:"\u041c\u041c/\u0413\u0413","MY PLANS":"\u041c\u041e\u0418 \u041f\u041b\u0410\u041d\u042b","Mark all as read":"\u043e\u0442\u043c\u0435\u0442\u0438\u0442\u044c \u0432\u0441\u0435 \u043a\u0430\u043a \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043d\u043d\u043e\u0435","Mark as complete":"\u041e\u0442\u043c\u0435\u0442\u0438\u0442\u044c \u043a\u0430\u043a \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u043e\u0435","Mark as read":"\u043f\u043e\u043c\u0435\u0442\u0438\u0442\u044c, \u043a\u0430\u043a \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043d\u043d\u043e\u0435","Mark as watched":"\u041e\u0442\u043c\u0435\u0442\u0438\u0442\u044c \u043a\u0430\u043a \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u043d\u043e\u0435","Maybe later":"\u041c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u043e\u0437\u0436\u0435","Member removed":"\u0423\u0447\u0430\u0441\u0442\u043d\u0438\u043a \u0443\u0434\u0430\u043b\u0435\u043d",Members:"\u0427\u043b\u0435\u043d\u044b",Menu:"\u041c\u0435\u043d\u044e","Message sent":"\u0421\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e","Messages sent":"\ud83d\udcac \u0421\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044b","Missing the action text":"\u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0442\u0435\u043a\u0441\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f","More people":"\u0411\u043e\u043b\u044c\u0448\u0435 \u043b\u044e\u0434\u0435\u0439, \u0431\u043e\u043b\u044c\u0448\u0435 \u043f\u043e\u0445\u043e\u0436\u0438\u0445 \u043d\u0430 \u0418\u0438\u0441\u0443\u0441\u0430","More people desc":"\u041d\u0430\u0448\u0430 \u0446\u0435\u043b\u044c \u2014 \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u0442\u044c \u0434\u0443\u0445\u043e\u0432\u043d\u044b\u0435 \u0431\u0435\u0441\u0435\u0434\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u043e\u0435\u0434\u0438\u043d\u044f\u044e\u0442 \u043b\u044e\u0434\u0435\u0439 \u0434\u0440\u0443\u0433 \u0441 \u0434\u0440\u0443\u0433\u043e\u043c \u0438 \u0441 \u043c\u0438\u0440\u043e\u043c.","Mute notifications":"\u041e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f","My Bible study":"\u041c\u043e\u0435 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u0411\u0438\u0431\u043b\u0438\u0438","My daily Bible study":"\u041c\u043e\u0435 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u0435 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u0411\u0438\u0431\u043b\u0438\u0438","NO THANKS":"\u0421\u041f\u0410\u0421\u0418\u0411\u041e, \u041d\u0415 \u041d\u0410\u0414\u041e",Name:"\u0418\u043c\u044f","Name on card":"\u0418\u043c\u044f \u043d\u0430 \u043a\u0430\u0440\u0442\u0435","Name, You have been invited to":"{{nameValue}}, \u0432\u0430\u0441 \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b\u0438 \u043d\u0430","Navigate to whats next by tapping on sides of the screen":"\u041f\u0435\u0440\u0435\u0445\u043e\u0434\u0438\u0442\u0435 \u043a \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c\u0443 \u0440\u0430\u0437\u0434\u0435\u043b\u0443, \u043d\u0430\u0436\u0438\u043c\u0430\u044f \u043f\u043e \u0431\u043e\u043a\u0430\u043c \u044d\u043a\u0440\u0430\u043d\u0430","Navigators plan":"\u041f\u043b\u0430\u043d \u043d\u0430\u0432\u0438\u0433\u0430\u0442\u043e\u0440\u043e\u0432","Never miss out":"\u041d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u0435!","New believers or non-believers":"\u041d\u043e\u0432\u044b\u0435 \u0432\u0435\u0440\u0443\u044e\u0449\u0438\u0435 \u0438\u043b\u0438 \u043d\u0435\u0432\u0435\u0440\u0443\u044e\u0449\u0438\u0435","New message":"\u041d\u043e\u0432\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435","NewLife church connects personally with members through text for important info":"{{orgName}} \u043b\u0438\u0447\u043d\u043e \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0441 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0430\u043c\u0438 \u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e\u043c \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u044b\u0445 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439 \u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0432\u0430\u0436\u043d\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438",Next:"\u0421\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439",No:"\u041d\u0435\u0442","No code desc":"\u0415\u0441\u043b\u0438 \u0432\u0430\u0441 \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b\u0438 \u043f\u043e \u0441\u0441\u044b\u043b\u043a\u0435, \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u044b\u0439\u0434\u0438\u0442\u0435 \u0438\u0437 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0438 \u0441\u043d\u043e\u0432\u0430 \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u0441\u0441\u044b\u043b\u043a\u0443 \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u0441\u0432\u043e\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u0435 \ud83d\udc4c","No code no problem":"\u041d\u0435\u0442 \u043a\u043e\u0434\u0430, \u043d\u0435\u0442 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b!","No giving":"\u041d\u0435 \u0434\u0430\u0432\u0430\u0442\u044c","No groups":"\u041d\u0435\u0442 \u0433\u0440\u0443\u043f\u043f","No new action steps":"\u041d\u0435\u0442 \u043d\u043e\u0432\u044b\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439","No new entries":"\u041d\u0435\u0442 \u043d\u043e\u0432\u044b\u0445 \u0437\u0430\u043f\u0438\u0441\u0435\u0439","No new prayers":"\u041d\u0435\u0442 \u043d\u043e\u0432\u044b\u0445 \u043c\u043e\u043b\u0438\u0442\u0432","No new study discussions":"\u041d\u0435\u0442 \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0439 \u043d\u043e\u0432\u043e\u0433\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f","No passages before":"\u0414\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u0432\u043e\u043f\u0440\u043e\u0441\u0430 \u043d\u0435\u0442 \u043f\u0440\u043e\u0445\u043e\u0434\u0430.","No thanks":"\u0421\u043f\u0430\u0441\u0438\u0431\u043e, \u043d\u0435 \u043d\u0430\u0434\u043e","Not a member of any group":"\u0412\u044b \u043d\u0435 \u0441\u043e\u0441\u0442\u043e\u0438\u0442\u0435 \u043d\u0438 \u0432 \u043e\u0434\u043d\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u0435, \u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u0435\u0441\u044c \u0438\u043b\u0438 \u0441\u043e\u0437\u0434\u0430\u0439\u0442\u0435 \u0433\u0440\u0443\u043f\u043f\u0443 \u043d\u0438\u0436\u0435","Not found QR Code":"QR-\u043a\u043e\u0434 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d","Not found email":"\u042f \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0438\u0441\u044c\u043c\u043e","Not now":"\u041d\u0435 \u0441\u0435\u0439\u0447\u0430\u0441","Not yet":"\u0415\u0449\u0435 \u043d\u043