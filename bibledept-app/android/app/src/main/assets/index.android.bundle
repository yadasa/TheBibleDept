\u043a\u0443","Add a text entry":"\u0414\u043e\u0434\u0430\u0439\u0442\u0435 \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441","Add text here":"\u0414\u043e\u0434\u0430\u0439\u0442\u0435 \u0442\u0435\u043a\u0441\u0442 \u0442\u0443\u0442","Add video content":"\u0414\u043e\u0434\u0430\u0439\u0442\u0435 \u0432\u0456\u0434\u0435\u043e\u0432\u043c\u0456\u0441\u0442","Adding in space to celebrate":"\u0414\u043e\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u043c\u0456\u0441\u0446\u044f \u0434\u043b\u044f \u0441\u0432\u044f\u0442\u043a\u0443\u0432\u0430\u043d\u043d\u044f",Age:"\u0412\u0456\u043a",All:"\u0432\u0441\u0456","Allow notifications":"\u0414\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u0438 \u0441\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f",Anonymous:"\u0410\u043d\u043e\u043d\u0456\u043c","Answer a few questions and you will be set up in no time":"\u0414\u0430\u0439\u0442\u0435 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u044c \u043d\u0430 \u043a\u0456\u043b\u044c\u043a\u0430 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u044c\ud83d\udcdd,\n\u0456 \u0432\u0438 \u0431\u0443\u0434\u0435\u0442\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0430\u043d\u0456 \u0432 \u043d\u0430\u0439\u043a\u043e\u0440\u043e\u0442\u0448\u0456 \u0442\u0435\u0440\u043c\u0456\u043d\u0438","Anxiety decreases 34":"\u2b07\ufe0f \u0422\u0440\u0438\u0432\u043e\u0433\u0430 \u0437\u043c\u0435\u043d\u0448\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u0430 34%",Any:"\u0411\u0443\u0434\u044c-\u044f\u043a\u0438\u0439","Are you sure":"\u0422\u0438 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0438\u0439?","Are you sure about that":"\u0412\u0438 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0456 \u0432 \u0446\u044c\u043e\u043c\u0443?","Are you sure you want to delete this card":"\u0412\u0438 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0456, \u0449\u043e \u0445\u043e\u0447\u0435\u0442\u0435\n\u0432\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0446\u044e \u043a\u0430\u0440\u0442\u043a\u0443?","Are you sure you want to delete this conversation":"\u0412\u0438 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0456, \u0449\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0446\u044e \u0440\u043e\u0437\u043c\u043e\u0432\u0443?","Are you sure you want to delete this group":"\u0412\u0438 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0456, \u0449\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0446\u044e \u0433\u0440\u0443\u043f\u0443?","Are you sure you want to delete this member":"\u0412\u0438 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0456, \u0449\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0446\u044c\u043e\u0433\u043e \u0443\u0447\u0430\u0441\u043d\u0438\u043a\u0430?","Are you sure you want to leave this group":"\u0412\u0438 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0456, \u0449\u043e \u0431\u0430\u0436\u0430\u0454\u0442\u0435 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u0446\u044e \u0433\u0440\u0443\u043f\u0443?","Automatic Prayer and Gratitude":"\u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0430 \u043c\u043e\u043b\u0438\u0442\u0432\u0430 \u0442\u0430 \u043f\u043e\u0434\u044f\u043a\u0430","Back to group":"\u041d\u0430\u0437\u0430\u0434 \u0434\u043e \u0433\u0440\u0443\u043f\u0438","Be on mission desc":"\u0429\u043e\u0431 \u043e\u0445\u043e\u043f\u0438\u0442\u0438 \u0441\u0432\u0456\u0442 \u0456 \u0432\u043f\u043b\u0438\u043d\u0443\u0442\u0438 \u043d\u0430 \u043d\u044c\u043e\u0433\u043e, \u043f\u043e\u0431\u0443\u0434\u0443\u0432\u0430\u0432\u0448\u0438 \u0432\u0435\u043b\u0438\u043a\u0443 \u0446\u0435\u0440\u043a\u0432\u0443, \u0437\u043e\u0441\u0435\u0440\u0435\u0434\u0436\u0435\u043d\u0443 \u043d\u0430 \u0425\u0440\u0438\u0441\u0442\u0456, \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d\u0443 \u043d\u0430 \u0411\u0456\u0431\u043b\u0456\u0457, \u0437\u043c\u0456\u043d\u044e\u044e\u0447\u0438 \u043c\u0438\u0441\u043b\u0435\u043d\u043d\u044f \u0442\u0430 \u043d\u0430\u0434\u0430\u044e\u0447\u0438 \u043b\u044e\u0434\u044f\u043c \u043c\u043e\u0436\u043b\u0438\u0432\u0456\u0441\u0442\u044c \u043b\u0456\u0434\u0438\u0440\u0443\u0432\u0430\u0442\u0438 \u0442\u0430 \u0432\u043f\u043b\u0438\u0432\u0430\u0442\u0438 \u0432 \u043a\u043e\u0436\u043d\u0456\u0439 \u0441\u0444\u0435\u0440\u0456 \u0436\u0438\u0442\u0442\u044f.","Be on mission with us":"\u0411\u0443\u0434\u044c \u043d\u0430 \u043c\u0456\u0441\u0456\u0457 \u0437 \u043d\u0430\u043c\u0438","Bible study leader":"\ud83d\udcda \u041b\u0456\u0434\u0435\u0440 \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f \u0411\u0456\u0431\u043b\u0456\u0457",Books:"\u041a\u043d\u0438\u0433\u0438","Build a Bible habit together":"\u0420\u043e\u0437\u0432\u0438\u0432\u0430\u0439\u0442\u0435 \u0431\u0456\u0431\u043b\u0456\u0439\u043d\u0443 \u0437\u0432\u0438\u0447\u043a\u0443\n \u0440\u0430\u0437\u043e\u043c \u26a1\ufe0f","Build a plan from scratch by selecting scripture and questions for your group":"\u0421\u0442\u0432\u043e\u0440\u0456\u0442\u044c \u043f\u043b\u0430\u043d \u0437 \u043d\u0443\u043b\u044f, \u0432\u0438\u0431\u0440\u0430\u0432\u0448\u0438 \u0443\u0440\u0438\u0432\u043e\u043a \u0456\u0437 \u041f\u0438\u0441\u0430\u043d\u044c \u0456 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u0434\u043b\u044f \u0432\u0430\u0448\u043e\u0457 \u0433\u0440\u0443\u043f\u0438.","Build a plan from scratch by selecting various scriptures and activities for your group":"\u0421\u0442\u0432\u043e\u0440\u0456\u0442\u044c \u043f\u043b\u0430\u043d \u0437 \u043d\u0443\u043b\u044f, \u0432\u0438\u0431\u0440\u0430\u0432\u0448\u0438 \u0440\u0456\u0437\u043d\u0456 \u0432\u0456\u0440\u0448\u0456 \u0437 \u041f\u0438\u0441\u0430\u043d\u044c \u0456 \u0432\u043f\u0440\u0430\u0432\u0438 \u0434\u043b\u044f \u0432\u0430\u0448\u043e\u0457 \u0433\u0440\u0443\u043f\u0438","Build bible together":"\u0420\u043e\u0437\u0432\u0438\u0432\u0430\u0439\u0442\u0435 \u0449\u043e\u0434\u0435\u043d\u043d\u0443 \u0431\u0456\u0431\u043b\u0456\u0439\u043d\u0443 \u0437\u0432\u0438\u0447\u043a\u0443 \u0440\u0430\u0437\u043e\u043c","Build bible together desc":"\u0412\u0438 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0435, \u043d\u0430\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u043b\u0435\u0433\u043a\u043e \u0441\u0442\u0430\u0454 \u0447\u0438\u0442\u0430\u043d\u043d\u044f \u0411\u0456\u0431\u043b\u0456\u0457, \u043a\u043e\u043b\u0438 \u0443 \u0432\u0430\u0441 \u0454 \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0430, \u044f\u043a\u0430 \u043c\u043e\u0442\u0438\u0432\u0443\u0454 \u0442\u0430 \u0437\u0430\u043e\u0445\u043e\u0447\u0443\u0454 \u0432\u0430\u0441 \u043d\u0430 \u0446\u044c\u043e\u043c\u0443 \u0448\u043b\u044f\u0445\u0443 \u2013 \u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u043f\u0440\u0438\u0454\u0434\u043d\u0430\u0454\u043c\u043e\u0441\u044f!","Building a plan for your group":"\u0421\u043a\u043b\u0430\u0434\u0430\u043d\u043d\u044f \u043f\u043b\u0430\u043d\u0443 \u0434\u043b\u044f \u0432\u0430\u0448\u043e\u0457 \u0433\u0440\u0443\u043f\u0438 \u26a1\ufe0f","Building communities for college campus students":"\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442 \u0434\u043b\u044f \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0456\u0432 \u043a\u043e\u043b\u0435\u0434\u0436\u0443","Can you pray for":"\u0427\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0432\u0438 \u043c\u043e\u043b\u0438\u0442\u0438\u0441\u044f \u0437\u0430",Cancel:"\u0421\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438","Cancel study":"\u0421\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f","BibleDept is possible thanks to donations from people like you":"\u041a\u0435\u0440\u0440\u0456 \u043c\u043e\u0436\u043b\u0438\u0432\u0438\u0439 \u0437\u0430\u0432\u0434\u044f\u043a\u0438 \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u0430\u043c \u0442\u0430\u043a\u0438\u0445 \u043b\u044e\u0434\u0435\u0439, \u044f\u043a \u0432\u0438.",Casual:"\u041f\u043e\u0432\u0441\u044f\u043a\u0434\u0435\u043d\u043d\u0438\u0439","Celebrate with":"\u0421\u0432\u044f\u0442\u043a\u0443\u0439\u0442\u0435 \u0437","Celebrate with your group members":"\u0421\u0432\u044f\u0442\u043a\u0443\u0439\u0442\u0435 \u0437 \u0447\u043b\u0435\u043d\u0430\u043c\u0438 \u0432\u0430\u0448\u043e\u0457 \u0433\u0440\u0443\u043f\u0438","Change Bible translation":"\u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u0430\u0434 \u0411\u0456\u0431\u043b\u0456\u0457","Change avatar":"\u0417\u043c\u0456\u043d\u0456\u0442\u044c \u0441\u0432\u0456\u0439 \u0430\u0432\u0430\u0442\u0430\u0440","Change conversation name":"\u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u043d\u0430\u0437\u0432\u0443 \u0440\u043e\u0437\u043c\u043e\u0432\u0438","Change goal":"\u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u0446\u0456\u043b\u044c","Change group name":"\u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u043d\u0430\u0437\u0432\u0443 \u0433\u0440\u0443\u043f\u0438","Change group picture":"\u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u0433\u0440\u0443\u043f\u0438","Change language":"\u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043c\u043e\u0432\u0438","Change name":"\u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u043d\u0430\u0437\u0432\u0443","Change reminder":"\u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u043d\u0430\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f","Change reminder time":"\u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u0447\u0430\u0441 \u043d\u0430\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f","Change start date":"\u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u0434\u0430\u0442\u0443 \u043f\u043e\u0447\u0430\u0442\u043a\u0443","Change to dark mode":"\u041f\u0435\u0440\u0435\u0439\u0442\u0438 \u0432 \u0442\u0435\u043c\u043d\u0438\u0439 \u0440\u0435\u0436\u0438\u043c","Change to light mode":"\u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u043d\u0430 \u0441\u0432\u0456\u0442\u043b\u0438\u0439 \u0440\u0435\u0436\u0438\u043c","Change your goal":"\u0417\u043c\u0456\u043d\u0456\u0442\u044c \u0441\u0432\u043e\u044e \u043c\u0435\u0442\u0443","Changed to group":"\u0417\u043c\u0456\u043d\u0435\u043d\u043e \u043d\u0430 \u0433\u0440\u0443\u043f\u0443 {{nameValue}}","Check out how name params took action this week":"\u041f\u043e\u0434\u0438\u0432\u0456\u0442\u044c\u0441\u044f, \u044f\u043a \u0434\u0456\u044f\u0432 {{nameValue}} \u0446\u044c\u043e\u0433\u043e \u0442\u0438\u0436\u043d\u044f!","Check out who celebrated with you this week":"\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435, \u0437 \u043a\u0438\u043c \u0441\u0432\u044f\u0442\u043a\u0443\u0432\u0430\u043b\u0438\n \u0442\u0438 \u0446\u044c\u043e\u0433\u043e \u0442\u0438\u0436\u043d\u044f \ud83c\udf89","Check out your group s activityfrom this week":"\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u044c\u0442\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c \u0432\u0430\u0448\u043e\u0457 \u0433\u0440\u0443\u043f\u0438\n\u0437 \u0446\u044c\u043e\u0433\u043e \u0442\u0438\u0436\u043d\u044f! \ud83d\udd25","Check your inbox":"\u2709\ufe0f \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0441\u0432\u043e\u044e \u043f\u043e\u0448\u0442\u043e\u0432\u0443 \u0441\u043a\u0440\u0438\u043d\u044c\u043a\u0443","Choose Privacy":"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u041a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u0456\u0441\u0442\u044c","Choose a Bible translation":"\ud83d\udcda \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043f\u0435\u0440\u0435\u043a\u043b\u0430\u0434 \u0411\u0456\u0431\u043b\u0456\u0457","Choose a book":"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043a\u043d\u0438\u0433\u0443","Choose a chapter":"\ud83d\udcd6 \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0440\u043e\u0437\u0434\u0456\u043b","Choose a duration":"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0442\u0440\u0438\u0432\u0430\u043b\u0456\u0441\u0442\u044c","Choose a future date":"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u044e \u0434\u0430\u0442\u0443","Choose a passage":"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0443\u0440\u0438\u0432\u043e\u043a","Choose a question":"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f","Choose a reminder time":"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0447\u0430\u0441 \u043d\u0430\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f","Choose a start date":"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0434\u0430\u0442\u0443 \u043f\u043e\u0447\u0430\u0442\u043a\u0443","Choose an activity":"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0432\u0438\u0434 \u0434\u0456\u044f\u043b\u044c\u043d\u043e\u0441\u0442\u0456","Choose chapters":"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0440\u043e\u0437\u0434\u0456\u043b\u0438","Choose language":"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043c\u043e\u0432\u0443","Choose privacy":"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u0456\u0441\u0442\u044c","Choose verses":"\ud83d\udcd6 \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0432\u0456\u0440\u0448\u0456","Choose what to read":"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043a\u043d\u0438\u0433\u0443 \u0434\u043b\u044f \u0447\u0438\u0442\u0430\u043d\u043d\u044f","Choose your daily questions":"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0449\u043e\u0434\u0435\u043d\u043d\u0456 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f","Choose your language":"\ud83c\udf0e \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0441\u0432\u043e\u044e \u043c\u043e\u0432\u0443","Choose your payment option":"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0441\u043f\u043e\u0441\u0456\u0431 \u043e\u043f\u043b\u0430\u0442\u0438","Church leader":"\u270d\ufe0f \u041a\u0435\u0440\u0456\u0432\u043d\u0438\u043a \u0446\u0435\u0440\u043a\u0432\u0438","Church member":"\ud83d\udc5f \u0427\u043b\u0435\u043d \u0446\u0435\u0440\u043a\u0432\u0438",Close:"\u0417\u0430\u043a\u0440\u0438\u0442\u0438",Complete:"\u041f\u043e\u0432\u043d\u0438\u0439","Complete today study":"\u0412\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456\u0448\u043d\u0454 \u0449\u043e\u0434\u0435\u043d\u043d\u0435 \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f, \u0449\u043e\u0431 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u043f\u043e\u0442\u043e\u0447\u043d\u0443 \u0441\u0435\u0440\u0456\u044e",Completed:"\u0412\u0438\u043a\u043e\u043d\u0430\u043d\u043e",Confirm:"\u041f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438","Confirm your details":"\u041f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u044c\u0442\u0435 \u0441\u0432\u043e\u0457 \u0434\u0430\u043d\u0456 \ud83d\udc4c","Confirm your name":"\u041f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u044c\u0442\u0435 \u0441\u0432\u043e\u0454 \u0456\u043c'\u044f \ud83d\udc4c","Connect with Org":"\u0417\u0432'\u044f\u0437\u0430\u0442\u0438\u0441\u044f \u0437\n{{orgName}} \u26a1\ufe0f","Connect with community":"\u041f\u0456\u0434\u043a\u043b\u044e\u0447\u0430\u0439\u0442\u0435\u0441\u044f \u0434\u043e \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0438","Connect with community desc":"\u0429\u043e\u0431 \u043e\u0445\u043e\u043f\u0438\u0442\u0438 \u0441\u0432\u0456\u0442 \u0456 \u0432\u043f\u043b\u0438\u043d\u0443\u0442\u0438 \u043d\u0430 \u043d\u044c\u043e\u0433\u043e, \u043f\u043e\u0431\u0443\u0434\u0443\u0432\u0430\u0432\u0448\u0438 \u0432\u0435\u043b\u0438\u043a\u0443 \u0446\u0435\u0440\u043a\u0432\u0443, \u0437\u043e\u0441\u0435\u0440\u0435\u0434\u0436\u0435\u043d\u0443 \u043d\u0430 \u0425\u0440\u0438\u0441\u0442\u0456, \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d\u0443 \u043d\u0430 \u0411\u0456\u0431\u043b\u0456\u0457, \u0437\u043c\u0456\u043d\u044e\u044e\u0447\u0438 \u043c\u0438\u0441\u043b\u0435\u043d\u043d\u044f \u0442\u0430 \u043d\u0430\u0434\u0430\u044e\u0447\u0438 \u043b\u044e\u0434\u044f\u043c \u043c\u043e\u0436\u043b\u0438\u0432\u0456\u0441\u0442\u044c \u043b\u0456\u0434\u0438\u0440\u0443\u0432\u0430\u0442\u0438 \u0442\u0430 \u0432\u043f\u043b\u0438\u0432\u0430\u0442\u0438 \u0432 \u043a\u043e\u0436\u043d\u0456\u0439 \u0441\u0444\u0435\u0440\u0456 \u0436\u0438\u0442\u0442\u044f.","Connect with others":"\u0421\u043f\u0456\u043b\u043a\u0443\u0439\u0442\u0435\u0441\u044f \u0437 \u0456\u043d\u0448\u0438\u043c\u0438",Continue:"\u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438","Continue goal":"\u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f",Conversation:"\u0420\u043e\u0437\u043c\u043e\u0432\u0430","Could not find that passage":" \u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u043d\u0430\u0439\u0442\u0438 \u0446\u0435\u0439 \u0443\u0440\u0438\u0432\u043e\u043a",Create:"\u0421\u0442\u0432\u043e\u0440\u0438\u0442\u0438","Create Group":"\u0421\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0433\u0440\u0443\u043f\u0443","Create a Group":"\u0421\u0442\u0432\u043e\u0440\u0456\u0442\u044c \u0431\u0456\u0431\u043b\u0456\u0439\u043d\u0443 \u0433\u0440\u0443\u043f\u0443","Create a group":"\u0421\u0442\u0432\u043e\u0440\u0456\u0442\u044c \u0433\u0440\u0443\u043f\u0443","Create a message and say hello to a group member":"\u0421\u0442\u0432\u043e\u0440\u0456\u0442\u044c \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u0442\u0430 \u043f\u0440\u0438\u0432\u0456\u0442\u0430\u0439\u0442\u0435\u0441\u044f \u0437 \u0443\u0447\u0430\u0441\u043d\u0438\u043a\u043e\u043c \u0433\u0440\u0443\u043f\u0438","Create a new plan":"\u0421\u0