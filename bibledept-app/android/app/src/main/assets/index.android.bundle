\u05dd. \u26a1\ufe0f",add_prayer_description:"\u05d0\u05e0\u05d5 \u05e0\u05e4\u05d6\u05e8 \u05d0\u05ea \u05d4\u05e0\u05d7\u05d9\u05d5\u05ea \u05d4\u05ea\u05e4\u05d9\u05dc\u05d4 \u05d4\u05dc\u05dc\u05d5 \u05dc\u05d0\u05d5\u05e8\u05da \u05d4\u05dc\u05d9\u05de\u05d5\u05d3 \u05e9\u05dc\u05da \u05db\u05d3\u05d9 \u05dc\u05e7\u05e8\u05d1 \u05d0\u05ea \u05d4\u05e7\u05d1\u05d5\u05e6\u05d4 \u05e9\u05dc\u05da \u05d6\u05d5 \u05dc\u05d6\u05d5. \u2728",add_question_description:"\u05e9\u05d0\u05dc\u05d5\u05ea \u05de\u05e1\u05e4\u05e7\u05d5\u05ea \u05d4\u05d6\u05d3\u05de\u05e0\u05d5\u05ea \u05de\u05e6\u05d5\u05d9\u05e0\u05ea \u05dc\u05e7\u05d1\u05d5\u05e6\u05d4 \u05e9\u05dc\u05da \u05dc\u05d4\u05e8\u05d4\u05e8 \u05d9\u05d7\u05d3 \u05de\u05d3\u05d9 \u05d9\u05d5\u05dd. \u2728\n\n\u05d4\u05d0\u05dd \u05ea\u05e8\u05e6\u05d4 \u05dc\u05d1\u05d7\u05d5\u05e8 \u05de\u05ea\u05d5\u05da \u05d0\u05d7\u05ea \u05de\u05d4\u05e9\u05d0\u05dc\u05d5\u05ea \u05d4\u05de\u05d5\u05db\u05e0\u05d5\u05ea \u05e9\u05dc\u05e0\u05d5 \u05d0\u05d5 \u05dc\u05db\u05ea\u05d5\u05d1 \u05d1\u05e2\u05e6\u05de\u05da?",add_text_description:"\u05d4\u05d7\u05d1\u05e8\u05d9\u05dd \u05e9\u05dc\u05da \u05d9\u05e8\u05d0\u05d5 \u05d0\u05ea \u05d4\u05d8\u05e7\u05e1\u05d8 \u05d4\u05d6\u05d4 \u05d1\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4, \u05db\u05d0\u05d7\u05ea \u05de\u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05d4\u05dc\u05d9\u05de\u05d5\u05d3 \u05d4\u05d9\u05d5\u05de\u05d9\u05d5\u05ea \u05e9\u05dc\u05d4\u05dd.\n\n\u05d6\u05d4 \u05e0\u05d4\u05d3\u05e8 \u05dc\u05d7\u05dc\u05d5\u05e7 \u05d0\u05ea \u05d4\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05dc\u05da \u05d0\u05d5 \u05dc\u05d4\u05e0\u05d7\u05d5\u05ea \u05d7\u05d1\u05e8\u05d9\u05dd.\ud83d\udca1 \u05db\u05de\u05d4 \u05d3\u05d5\u05d2\u05de\u05d0\u05d5\u05ea \u05e0\u05d4\u05d3\u05e8\u05d5\u05ea \u05d4\u05df \u05d4\u05e7\u05d3\u05e9\u05d4 \u05e7\u05e6\u05e8\u05d4, \u05d4\u05e0\u05d7\u05d9\u05d5\u05ea \u05dc\u05de\u05d3\u05d9\u05d8\u05e6\u05d9\u05d9\u05ea \u05ea\u05e