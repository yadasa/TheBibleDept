043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0443\u0434\u0430\u043b\u0435\u043d\u043e.","Study discussions":"\u0423\u0447\u0435\u0431\u043d\u044b\u0435 \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f","Study discussions from the daily study will appear here":"\u0417\u0434\u0435\u0441\u044c \u0431\u0443\u0434\u0443\u0442 \u043f\u043e\u044f\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f \u0438\u0437 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u0433\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f.","Study discussions with icon":"\u0418\u0437\u0443\u0447\u0430\u0439\u0442\u0435 \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f \ud83d\udcac","Study ended":"\u0423\u0447\u0435\u0431\u0430 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b\u0430\u0441\u044c.","Study plans":"\u0423\u0447\u0435\u0431\u043d\u044b\u0435 \u043f\u043b\u0430\u043d\u044b","Study published":"\u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043e!",Successfully:"\u0423\u0441\u043f\u0435\u0448\u043d\u043e!","Switch group":"\u0413\u0440\u0443\u043f\u043f\u0430 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u0435\u0439","Take Action":"\u041f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u043c\u0435\u0440\u044b","Tap Add activity to start":"\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \xab\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\xbb, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0447\u0430\u0442\u044c.","Tap Add day to start":"\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \xab\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0434\u0435\u043d\u044c\xbb \u0438\u043b\u0438 \xab\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043d\u0435\u0434\u0435\u043b\u044e\xbb.\n \u043d\u0430\u0447\u0430\u0442\u044c","Tap here to join my group":"\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u0437\u0434\u0435\u0441\u044c, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u044c\u0441\u044f \u043a \u043c\u043e\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u0435!","Tap here to view group members and other menu items":"\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u0437\u0434\u0435\u0441\u044c, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432 \u0433\u0440\u0443\u043f\u043f\u044b \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u044b \u043c\u0435\u043d\u044e.","Tap passage":"\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \xab\u041f\u0440\u043e\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435\xbb, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0447\u0430\u0442\u044c","Tap the All button to view past action steps":"\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 \xab\u0412\u0441\u0435\xbb, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043f\u0440\u043e\u0448\u043b\u044b\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f.","Tap the All button to view past giving":"\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 \xab\u0412\u0441\u0435\xbb, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043f\u0440\u043e\u0448\u043b\u044b\u0435 \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f.","Tap the All button to view past gratitude entries":"\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 \xab\u0412\u0441\u0435\xbb, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043f\u0440\u043e\u0448\u043b\u044b\u0435 \u0437\u0430\u043f\u0438\u0441\u0438 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u0435\u0439.","Tap the All button to view past prayers":"\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 \xab\u0412\u0441\u0435\xbb, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043f\u0440\u043e\u0448\u043b\u044b\u0435 \u043c\u043e\u043b\u0438\u0442\u0432\u044b","Tap the button below to create a plan":"\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 \u043d\u0438\u0436\u0435, \u0447\u0442\u043e\u0431\u044b\n \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u043f\u043b\u0430\u043d","Tap to begin":"\ud83d\udc46\u041d\u0430\u0436\u043c\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0447\u0430\u0442\u044c","Tap verses to add to your message":"\u041a\u043e\u0441\u043d\u0438\u0442\u0435\u0441\u044c \u0441\u0442\u0438\u0445\u043e\u0432, \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c\n\u043a \u0442\u0432\u043e\u0435\u043c\u0443 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044e","Tell me more":"\u0420\u0430\u0441\u0441\u043a\u0430\u0436\u0438 \u043c\u043d\u0435 \u0431\u043e\u043b\u044c\u0448\u0435...",Text:"\u0422\u0435\u043a\u0441\u0442","The final step":"\u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0448\u0430\u0433!","This action will delete all saved information for card":"\u042d\u0442\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0443\u0434\u0430\u043b\u0438\u0442 \u0432\u0441\u044e \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043d\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e {{brand}}, \u043e\u043a\u0430\u043d\u0447\u0438\u0432\u0430\u044e\u0449\u0443\u044e\u0441\u044f \u043d\u0430 {{last4}}.","This helps us find people just like you":"\u042d\u0442\u043e \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u0442 \u043d\u0430\u043c \u043d\u0430\u0439\u0442\u0438\n\u0442\u0430\u043a\u0438\u0435 \u0436\u0435 \u043b\u044e\u0434\u0438, \u043a\u0430\u043a \u0442\u044b.","This invite may have expired":"\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0441\u0440\u043e\u043a \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u044d\u0442\u043e\u0433\u043e \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044f \u0438\u0441\u0442\u0435\u043a, \u0438\u043b\u0438\n\u0443 \u0432\u0430\u0441 \u043c\u043e\u0436\u0435\u0442 \u043d\u0435 \u0431\u044b\u0442\u044c \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f \u043d\u0430\n\u0432\u0441\u0442\u0443\u043f\u0438\u0442\u044c \u0432 \u0433\u0440\u0443\u043f\u043f\u0443...","This video explains how you can get the most out of BibleDept":"\u0412 \u044d\u0442\u043e\u043c \u0432\u0438\u0434\u0435\u043e \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0435\u0442\u0441\u044f, \u043a\u0430\u043a \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c\n\u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u0438\u0437 {{org_name}}","This weeks most active members were":"\u0421\u0430\u043c\u044b\u043c\u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c\u0438\\n \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0430\u043c\u0438 \u043d\u0430 \u044d\u0442\u043e\u0439 \u043d\u0435\u0434\u0435\u043b\u0435 \u0431\u044b\u043b\u0438...\u26a1\ufe0f","This will help people in your city find your reading group":"\u042d\u0442\u043e \u043f\u043e\u043c\u043e\u0436\u0435\u0442 \u043b\u044e\u0434\u044f\u043c \u0432 \u0432\u0430\u0448\u0435\u043c \u0433\u043e\u0440\u043e\u0434\u0435 \u043d\u0430\u0439\u0442\u0438 \u0432\u0430\u0448\u0443 \u0433\u0440\u0443\u043f\u043f\u0443 \u0447\u0442\u0435\u043d\u0438\u044f","This will help us create studies perfect for your group":"\u042d\u0442\u043e \u043f\u043e\u043c\u043e\u0436\u0435\u0442 \u043d\u0430\u043c \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f, \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0438\u0435 \u0434\u043b\u044f \u0432\u0430\u0448\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u044b!","Title your text entry":"\u041d\u0430\u0437\u043e\u0432\u0438\u0442\u0435 \u0441\u0432\u043e\u044e \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u0443\u044e \u0437\u0430\u043f\u0438\u0441\u044c","Title your video":"\u041d\u0430\u0437\u043e\u0432\u0438\u0442\u0435 \u0441\u0432\u043e\u0435 \u0432\u0438\u0434\u0435\u043e",To:"\u041a","To fully delete your account we need you to login again":"\u0427\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0443\u0434\u0430\u043b\u0438\u0442\u044c \u0441\u0432\u043e\u044e \u0443\u0447\u0435\u0442\u043d\u0443\u044e \u0437\u0430\u043f\u0438\u0441\u044c, \u043d\u0430\u043c \u043d\u0443\u0436\u043d\u043e, \u0447\u0442\u043e\u0431\u044b \u0432\u044b \u0441\u043d\u043e\u0432\u0430 \u0432\u043e\u0448\u043b\u0438 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0443.",Todo:"\u0421\u0434\u0435\u043b\u0430\u0442\u044c","Try again":"\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0435 \u0440\u0430\u0437","Turn reminder off":"\u041e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435","Type a message":"\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435...","Type a verse range":"\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d \u0441\u0442\u0438\u0445\u043e\u0432","Unable to save your process":{" Do you want to back":"\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0432\u0430\u0448 \u043f\u0440\u043e\u0446\u0435\u0441\u0441.\n\u0412\u044b \u0445\u043e\u0442\u0438\u0442\u0435 \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f?"},"Unable to save your selection":"\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0432\u0430\u0448 \u0432\u044b\u0431\u043e\u0440!",Unknown:"\u041d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439","Unmute notifications":"\u0412\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f",Unread:"\u041d\u0435 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043d\u043e","Untitled day":"\u0414\u0435\u043d\u044c \u0431\u0435\u0437 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f","Untitled plan":"\u041f\u043b\u0430\u043d \u0431\u0435\u0437 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f",Upcoming:"\u041f\u0440\u0435\u0434\u0441\u0442\u043e\u044f\u0449\u0438\u0435","Update card":"\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043a\u0430\u0440\u0442\u044b","Update contact info":"\u041e\u0431\u043d\u043e\u0432\u0438\u0442\u044c \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043d\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e","Update group name success":"\u0423\u0441\u043f\u0435\u0448\u043d\u043e\u0435 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0438\u043c\u0435\u043d\u0438 \u0433\u0440\u0443\u043f\u043f\u044b","Update profile":"\u041e\u0431\u043d\u043e\u0432\u0438\u0442\u044c \u043f\u0440\u043e\u0444\u0438\u043b\u044c",Upgrade:"\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435","Use an existing plan or create a new plan from scratch":"\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0439 \u043f\u043b\u0430\u043d \u0438\u043b\u0438 \u0441\u043e\u0437\u0434\u0430\u0439\u0442\u0435 \u043d\u043e\u0432\u044b\u0439\n\u043d\u043e\u0432\u044b\u0439 \u043f\u043b\u0430\u043d \u0441 \u043d\u0443\u043b\u044f \ud83c\udfa8","Use this plan":"\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u044d\u0442\u043e\u0442 \u043f\u043b\u0430\u043d",Video:"\u0432\u0438\u0434\u0435\u043e",View:"\u0412\u0438\u0434","View action":"\u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435","View all entries":"\u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0432\u0441\u0435 \u0437\u0430\u043f\u0438\u0441\u0438","View all prayers":"\u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0432\u0441\u0435 \u043c\u043e\u043b\u0438\u0442\u0432\u044b","View campaign":"\u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043a\u0430\u043c\u043f\u0430\u043d\u0438\u044e","View discussion":"\u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0435","View entry":"\u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0437\u0430\u043f\u0438\u0441\u044c","View more":"\u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435...","View prayer":"\u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043c\u043e\u043b\u0438\u0442\u0432\u0443","View previous prayers":"\u041f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0435 \u043c\u043e\u043b\u0438\u0442\u0432\u044b, \u0437\u0430\u043f\u0438\u0441\u0438 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u0435\u0439 \u0438 \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f \u043d\u0438\u0436\u0435.","View reward":"\u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043c\u043e\u044e \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u0437\u0430 \u0443\u0447\u0435\u0431\u0443","View todays study":"\u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0441\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0435\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435","We created this plan for your group":"\u041c\u044b \u0441\u043e\u0437\u0434\u0430\u043b\u0438 \u044d\u0442\u043e\u0442 \u043f\u043b\u0430\u043d\n \u0434\u043b\u044f \u0432\u0430\u0448\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u044b \u2728","We stay in touch":"\u041e\u0441\u0442\u0430\u0435\u043c\u0441\u044f \u043d\u0430 \u0441\u0432\u044f\u0437\u0438","We will be discussing these questions":"\u041c\u044b \u043e\u0431\u0441\u0443\u0434\u0438\u043c \u044d\u0442\u0438 \u0432\u043e\u043f\u0440\u043e\u0441\u044b","We will make sure to take it easy on the weekends":"\u041c\u044b \u043f\u043e\u0437\u0430\u0431\u043e\u0442\u0438\u043c\u0441\u044f \u043e \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u043d\u0430 \u0432\u044b\u0445\u043e\u0434\u043d\u044b\u0445 \u0431\u044b\u043b\u043e \u043b\u0435\u0433\u043a\u043e!","We will queue this up for your group":"\u041c\u044b \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043c \u044d\u0442\u043e \u0432 \u043e\u0447\u0435\u0440\u0435\u0434\u044c \u0434\u043b\u044f \u0432\u0430\u0448\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u044b",Week:"\u041d\u0435\u0434\u0435\u043b\u044f","Weekly review":"\u0415\u0436\u0435\u043d\u0435\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u043e\u0431\u0437\u043e\u0440",Welcome:"\u041b\u0435\u0433\u0447\u0435 \u0432\u044b\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0431\u0438\u0431\u043b\u0435\u0439\u0441\u043a\u0443\u044e \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0443\n\u043a\u043e\u0433\u0434\u0430 \u043c\u044b \u0434\u0435\u043b\u0430\u0435\u043c \u044d\u0442\u043e \u0432\u043c\u0435\u0441\u0442\u0435","Welcome back":"\u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u043e\u0431\u0440\u0430\u0442\u043d\u043e!","Welcome home":"\u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0434\u043e\u043c\u043e\u0439","Welcome to BibleDept":"\u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0432 {{org_name}}!","Welcome to the group":"\u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0432 \u0433\u0440\u0443\u043f\u043f\u0443!","What are you thankful to God for today":"\u0417\u0430 \u0447\u0442\u043e \u0432\u044b \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u044b \u0411\u043e\u0433\u0443?","What do people call you":"\u041a\u0430\u043a \u0442\u0435\u0431\u044f \u0437\u043e\u0432\u0443\u0442 \u043b\u044e\u0434\u0438?","What do you need prayer for today":"\u041e \u0447\u0435\u043c \u0432\u0430\u043c \u043d\u0443\u0436\u043d\u0430 \u043c\u043e\u043b\u0438\u0442\u0432\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f?","What would you like your group to pray for":"\u041e \u0447\u0435\u043c \u0431\u044b \u0432\u044b \u0445\u043e\u0442\u0435\u043b\u0438, \u0447\u0442\u043e\u0431\u044b \u0432\u0430\u0448\u0430 \u0433\u0440\u0443\u043f\u043f\u0430 \u043c\u043e\u043b\u0438\u043b\u0430\u0441\u044c?","When do you want to start":"\ud83d\uddd3 \u041a\u043e\u0433\u0434\u0430 \u043d\u0430\u0447\u0430\u0442\u044c?","Which best describes you":"\u0427\u0442\u043e \u043b\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442 \u0432\u0430\u0441?","Who are you thankful for this week and why":"\u041a\u043e\u043c\u0443 \u0432\u044b \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u044b \u0437\u0430 \u044d\u0442\u0443 \u043d\u0435\u0434\u0435\u043b\u044e \u0438 \u043f\u043e\u0447\u0435\u043c\u0443?","Who is your group made up of":"\ud83d\udc65 \u0418\u0437 \u043a\u043e\u0433\u043e \u0441\u043e\u0441\u0442\u043e\u0438\u0442 \u0432\u0430\u0448\u0430 \u0433\u0440\u0443\u043f\u043f\u0430?","Why are you creating group":"\ud83d\ude4f \u0417\u0430\u0447\u0435\u043c \u0432\u044b \u0441\u043e\u0437\u0434\u0430\u0435\u0442\u0435 \u0433\u0440\u0443\u043f\u043f\u0443?","Wow sounds great":"\u0412\u0430\u0443, \u0437\u0432\u0443\u0447\u0438\u0442 \u0437\u0434\u043e\u0440\u043e\u0432\u043e!","Write a gratitude prompt":"\u041d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u043f\u0438\u0441\u044c\u043c\u043e \u0441 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u044c\u044e\u2026","Write a prayer prompt":"\u041d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u043c\u043e\u043b\u0438\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0443\u2026","Write a prompt":"\u041d\u0430\u043f\u0438\u0441\u0430\u0442\u044c \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0443","Write a prompt for your group to answer":"\u041d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0443 \u0434\u043b\u044f \u0432\u0430\u0448\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u044b, \u0447\u0442\u043e\u0431\u044b \u043e\u0442\u0432\u0435\u0442\u0438\u0442\u044c \ud83d\udc47","Write a question":"\u041d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u0432\u043e\u043f\u0440\u043e\u0441","Write an action":"\u041d\u0430\u043f\u0438\u0441\u0430\u0442\u044c \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435","Write description here":"\u041d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0437\u0434\u0435\u0441\u044c...","Write my own question":"\u041d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u043c\u043e\u0439 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0432\u043e\u043f\u0440\u043e\u0441","Write out or paste your text entry below":"\u041d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u0438\u043b\u0438 \u0432\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u0442\u0435\u043a\u0441\u0442 \u043d\u0438\u0436\u0435 \ud83d\udc47","Write your own":"\u041d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u0441\u0432\u043e\u0439...","Write your own action here":"\u041d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u0441\u0432\u043e\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0437\u0434\u0435\u0441\u044c","Write your own question here":"\u041d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u0437\u0434\u0435\u0441\u044c \u0441\u0432\u043e\u0439 \u0432\u043e\u043f\u0440\u043e\u0441",Yes:"\u0414\u0430","Yes I want to help":"\u0414\u0430, \u044f \u0445\u043e\u0447\u0443 \u043f\u043e\u043c\u043e\u0447\u044c!","Yes continue":"\u0414\u0430, \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c","Yes delete":"\u0414\u0430, \u0443\u0434\u0430\u043b\u0438\u0442\u044c","Yes replace it":"\u0414\u0430, \u0437\u0430\u043c\u0435\u043d\u0438",You:"\u0422\u044b","You are about to lose your streak":"\ud83d\udd25 \u0412\u044b \u0432\u043e\u0442-\u0432\u043e\u0442 \u043f\u043e\u0442\u0435\u0440\u044f\u0435\u0442\u0435 \u0441\u0432\u043e\u044e \u0441\u0435\u0440\u0438\u044e","You are already a part of":"\u0412\u044b \u0443\u0436\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0435\u0441\u044c \u0447\u0430\u0441\u0442\u044c\u044e","You are already part of another organisation and cannot accept this invite":"\u0412\u044b \u0443\u0436\u0435 \u0441\u043e\u0441\u0442\u043e\u0438\u0442\u0435 \u0432 \u0434\u0440\u0443\u0433\u043e\u0439 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438 \u0438 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0440\u0438\u043d\u044f\u0442\u044c \u044d\u0442\u043e \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435.","You are doing a great job":"\u0412\u044b \u0434\u0435\u043b\u0430\u0435\u0442\u0435 \u043e\u0442\u043b\u0438\u0447\u043d\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443","You are in another organization":"\u0412\u044b \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0435\u0441\u044c \u0432 \u0434\u0440\u0443\u0433\u043e\u0439 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438.","You can always change goals later":"\u0412\u044b \u0432\u0441\u0435\u0433\u0434\u0430 \u043c\u043e\u0436\u0435\u0442\u0435\n\u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0446\u0435\u043b\u044c \u043f\u043e\u0437\u0436\u0435","You have been invited to":"\u0412\u0430\u0441 \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b\u0438 \u043d\u0430","You have created":"\u0412\u044b \u0441\u043e\u0437\u0434\u0430\u043b\u0438","You have no action steps":"\u0423 \u0432\u0430\u0441 \u043d\u0435\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439!","You have no entries":"\u0423 \u0432\u0430\u0441 \u043d\u0435\u0442 \u0437\u0430\u043f\u0438\u0441\u0435\u0439!","You have no messages":"\u0423 \u0432\u0430\u0441 \u043d\u0435\u0442 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439!","You have no plans":"\u0423 \u0442\u0435\u0431\u044f \u043d\u0435\u0442 \u043f\u043b\u0430\u043d\u043e\u0432","You have no prayers":"\u0423 \u0442\u0435\u0431\u044f \u043d\u0435\u0442 \u043c\u043e\u043b\u0438\u0442\u0432!","You have no prayers!":"\u0423 \u0442\u0435\u0431\u044f \u043d\u0435\u0442 \u043c\u043e\u043b\u0438\u0442\u0432!","You reached your daily goal":"\u0412\u044b \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b\u0438 \u0441\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0435\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435!","You replied to gratitude":"\u0412\u044b \u043e\u0442\u0432\u0435\u0442\u0438\u043b\u0438 \u043d\u0430 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u044c {{nameValue}}","You replied to prayer":"\u0412\u044b \u043e\u0442\u0432\u0435\u0442\u0438\u043b\u0438 \u043d\u0430 {{nameValue}} \u043c\u043e\u043b\u0438\u0442\u0432\u0443","Your content is empty":"\u0412\u0430\u0448 \u043a\u043e\u043d\u0442\u0435\u043d\u0442 \u043f\u0443\u0441\u0442!","Your current study is almost finished":{" Let is queue up the next one":"\u0412\u0430\u0448\u0435 \u0442\u0435\u043a\u0443\u0449\u0435\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0447\u0442\u0438 \u0437\u0430\u043a\u043e\u043d\u0447\u0435\u043d\u043e. \u0421\u0442\u0430\u0432\u0438\u043c \u0432 \u043e\u0447\u0435\u0440\u0435\u0434\u044c \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439!"},"Your gift amount":"\u0421\u0443\u043c\u043c\u0430 \u0432\u0430\u0448\u0435\u0433\u043e \u043f\u043e\u0434\u0430\u0440\u043a\u0430:","Your gratitude entry":"\u0412\u0430\u0448\u0430 \u0437\u0430\u043f\u0438\u0441\u044c \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u0438","Your group is good to go":"\u0412\u0430\u0448\u0430 \u0433\u0440\u0443\u043f\u043f\u0430 \u0433\u043e\u0442\u043e\u0432\u0430! \u2728","Your group s action steps will appear here":"\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0432\u0430\u0448\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u044b \u043f\u043e\u044f\u0432\u044f\u0442\u0441\u044f \u0437\u0434\u0435\u0441\u044c.","Your plan was created":"\u0412\u0430\u0448 \u043f\u043b\u0430\u043d \u0441\u043e\u0437\u0434\u0430\u043d!","Your prayer request":"\u0412\u0430\u0448\u0430 \u043c\u043e\u043b\u0438\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u0430","Your selected start date overlaps with a future study":{" Do you want to replace that future study":"\u0412\u044b\u0431\u0440\u0430\u043d\u043d\u0430\u044f \u0432\u0430\u043c\u0438 \u0434\u0430\u0442\u0430 \u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u043e\u0432\u043f\u0430\u0434\u0430\u0435\u0442 \u0441 \u0431\u0443\u0434\u0443\u0449\u0438\u043c \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\u043c. \u0412\u044b \u0445\u043e\u0442\u0438\u0442\u0435 \u0437\u0430\u043c\u0435\u043d\u0438\u0442\u044c \u044d\u0442\u043e \u0431\u0443\u0434\u0443\u0449\u0435\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435?"},"Your selected start date overlaps with your current study":{" Do you want to replace your current study":"\u0412\u044b\u0431\u0440\u0430\u043d\u043d\u0430\u044f \u0432\u0430\u043c\u0438 \u0434\u0430\u0442\u0430 \u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u043e\u0432\u043f\u0430\u0434\u0430\u0435\u0442 \u0441 \u0432\u