\u043f\u043e\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u043f\u043b\u0430\u043d\u0443","Start day":"\u0414\u0435\u043d\u044c \u043f\u043e\u0447\u0430\u0442\u043a\u0443","Start reading":"\u041f\u043e\u0447\u0430\u0442\u043e\u043a %{value}","Start study plan today ":"\u0420\u043e\u0437\u043f\u043e\u0447\u043d\u0456\u0442\u044c \u043d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u0438\u0439 \u043f\u043b\u0430\u043d \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456","Start time is updated":"\u0427\u0430\u0441 \u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043e.","Start today s study by tapping on the button above":"\u041f\u043e\u0447\u043d\u0456\u0442\u044c \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456\u0448\u043d\u0454 \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f, \u043d\u0430\u0442\u0438\u0441\u043d\u0443\u0432\u0448\u0438 \u043a\u043d\u043e\u043f\u043a\u0443 \u0432\u0438\u0449\u0435.","Start today study":"\u041f\u043e\u0447\u043d\u0456\u0442\u044c \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456\u0448\u043d\u0454 \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f","Start todays study":"\u041f\u043e\u0447\u043d\u0456\u0442\u044c \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456\u0448\u043d\u0454 \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f","Starting in":"\u041f\u043e\u0447\u0438\u043d\u0430\u044e\u0447\u0438 \u0437 {{currentBlockIndex}} \u0434\u0435\u043d\u044c","Starting in s":"\u041f\u043e\u0447\u0438\u043d\u0430\u0454\u0442\u044c\u0441\u044f \u0447\u0435\u0440\u0435\u0437 {{currentBlockIndex}} \u0434\u043d\u0456\u0432","Starting study in":"\u041f\u043e\u0447\u0430\u0442\u043e\u043a \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u0447\u0435\u0440\u0435\u0437 {{dayNumber}} {{dayLabel}}","Streaks gained":"\ud83d\udd25\ufe0f \u0417\u0434\u043e\u0431\u0443\u0442\u0456 \u0441\u0435\u0440\u0456\u0457",Study:"\u0414\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f","Study deleted":"\u0414\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043e.","Study discussions":"\u041d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u0456 \u0434\u0438\u0441\u043a\u0443\u0441\u0456\u0457","Study discussions from the daily study will appear here":"\u041d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u0456 \u043e\u0431\u0433\u043e\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u0437 \u0449\u043e\u0434\u0435\u043d\u043d\u043e\u0433\u043e \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f \u0437\u2019\u044f\u0432\u043b\u044f\u0442\u0438\u043c\u0443\u0442\u044c\u0441\u044f \u0442\u0443\u0442","Study discussions with icon":"\u041d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u0456 \u0434\u0438\u0441\u043a\u0443\u0441\u0456\u0457 \ud83d\udcac","Study ended":"\u0414\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f \u0437\u0430\u043a\u0456\u043d\u0447\u0435\u043d\u043e.","Study plans":"\u041d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u0456 \u043f\u043b\u0430\u043d\u0438","Study published":"\u0414\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u043e\u0432\u0430\u043d\u043e!",Successfully:"\u0423\u0441\u043f\u0456\u0448\u043d\u043e!","Switch group":"\u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u0433\u0440\u0443\u043f\u0443","Take Action":"\u0414\u0456\u044f\u0442\u0438","Tap Add activity to start":"\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \xab\u0414\u043e\u0434\u0430\u0442\u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c\xbb, \u0449\u043e\u0431 \u043f\u043e\u0447\u0430\u0442\u0438","Tap Add day to start":"\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \xab\u0414\u043e\u0434\u0430\u0442\u0438 \u0434\u0435\u043d\u044c\xbb \u0430\u0431\u043e \xab\u0414\u043e\u0434\u0430\u0442\u0438 \u0442\u0438\u0436\u0434\u0435\u043d\u044c\xbb\n \u043f\u043e\u0447\u0438\u043d\u0430\u0442\u0438","Tap here to join my group":"\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u0442\u0443\u0442, \u0449\u043e\u0431 \u043f\u0440\u0438\u0454\u0434\u043d\u0430\u0442\u0438\u0441\u044f \u0434\u043e \u043c\u043e\u0454\u0457 \u0433\u0440\u0443\u043f\u0438!","Tap here to view group members and other menu items":"\u0422\u043e\u0440\u043a\u043d\u0456\u0442\u044c\u0441\u044f \u0442\u0443\u0442, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u0443\u0447\u0430\u0441\u043d\u0438\u043a\u0456\u0432 \u0433\u0440\u0443\u043f\u0438 \u0442\u0430 \u0456\u043d\u0448\u0456 \u043f\u0443\u043d\u043a\u0442\u0438 \u043c\u0435\u043d\u044e.","Tap passage":"\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \xab\u041f\u0440\u043e\u0445\u0456\u0434\xbb, \u0449\u043e\u0431 \u043f\u043e\u0447\u0430\u0442\u0438","Tap the All button to view past action steps":"\u0422\u043e\u0440\u043a\u043d\u0456\u0442\u044c\u0441\u044f \u043a\u043d\u043e\u043f\u043a\u0438 \xab\u0423\u0441\u0456\xbb, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456 \u0434\u0456\u0457","Tap the All button to view past giving":"\u0422\u043e\u0440\u043a\u043d\u0456\u0442\u044c\u0441\u044f \u043a\u043d\u043e\u043f\u043a\u0438 \xab\u0423\u0441\u0456\xbb, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u043c\u0438\u043d\u0443\u043b\u0456 \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u0438","Tap the All button to view past gratitude entries":"\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043a\u043d\u043e\u043f\u043a\u0443 \xab\u0423\u0441\u0456\xbb, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u043f\u043e\u0434\u044f\u043a\u0438","Tap the All button to view past prayers":"\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043a\u043d\u043e\u043f\u043a\u0443 \xab\u0423\u0441\u0456\xbb, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456 \u043c\u043e\u043b\u0438\u0442\u0432\u0438","Tap the button below to create a plan":"\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043a\u043d\u043e\u043f\u043a\u0443 \u043d\u0438\u0436\u0447\u0435, \u0449\u043e\u0431\n \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u043f\u043b\u0430\u043d","Tap to begin":"\ud83d\udc46\u0422\u043e\u0440\u043a\u043d\u0456\u0442\u044c\u0441\u044f, \u0449\u043e\u0431 \u043f\u043e\u0447\u0430\u0442\u0438","Tap verses to add to your message":"\u0422\u043e\u0440\u043a\u043d\u0456\u0442\u044c\u0441\u044f \u0432\u0456\u0440\u0448\u0456\u0432, \u0449\u043e\u0431 \u0434\u043e\u0434\u0430\u0442\u0438\n\u0434\u043e \u0432\u0430\u0448\u043e\u0433\u043e \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f","Tell me more":"\u0420\u043e\u0437\u043a\u0430\u0436\u0438 \u043c\u0435\u043d\u0456 \u0431\u0456\u043b\u044c\u0448\u0435...",Text:"\u0442\u0435\u043a\u0441\u0442","The final step":"\u041e\u0441\u0442\u0430\u043d\u043d\u0456\u0439 \u043a\u0440\u043e\u043a!","This action will delete all saved information for card":"\u0426\u044f \u0434\u0456\u044f \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u044c \u0432\u0441\u044e \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0443 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e {{brand}}, \u043d\u043e\u043c\u0435\u0440 \u044f\u043a\u043e\u0433\u043e \u0437\u0430\u043a\u0456\u043d\u0447\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u0430 {{last4}}","This helps us find people just like you":"\u0426\u0435 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u0454 \u043d\u0430\u043c \u0437\u043d\u0430\u0439\u0442\u0438\n\u0442\u0430\u043a\u0456 \u0436 \u043b\u044e\u0434\u0438, \u044f\u043a \u0442\u0438.","This invite may have expired":"\u041c\u043e\u0436\u043b\u0438\u0432\u043e, \u0442\u0435\u0440\u043c\u0456\u043d \u0434\u0456\u0457 \u0446\u044c\u043e\u0433\u043e \u0437\u0430\u043f\u0440\u043e\u0448\u0435\u043d\u043d\u044f \u0437\u0430\u043a\u0456\u043d\u0447\u0438\u0432\u0441\u044f, \u0430\u0431\u043e\n\u043c\u043e\u0436\u043b\u0438\u0432\u043e, \u0443 \u0432\u0430\u0441 \u043d\u0435\u043c\u0430\u0454 \u0434\u043e\u0437\u0432\u043e\u043b\u0443\n\u043f\u0440\u0438\u0454\u0434\u043d\u0430\u0442\u0438\u0441\u044f \u0434\u043e \u0433\u0440\u0443\u043f\u0438...","This video explains how you can get the most out of BibleDept":"\u0423 \u0446\u044c\u043e\u043c\u0443 \u0432\u0456\u0434\u0435\u043e \u043f\u043e\u044f\u0441\u043d\u044e\u0454\u0442\u044c\u0441\u044f, \u044f\u043a \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438\n\u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448\u0435 \u0437 {{org_name}}","This weeks most active members were":"\u041d\u0430\u0439\u0430\u043a\u0442\u0438\u0432\u043d\u0456\u0448\u0438\u043c\u0438\\n \u0443\u0447\u0430\u0441\u043d\u0438\u043a\u0430\u043c\u0438 \u0446\u044c\u043e\u0433\u043e \u0442\u0438\u0436\u043d\u044f \u0431\u0443\u043b\u0438...\u26a1\ufe0f","This will help people in your city find your reading group":"\u0426\u0435 \u0434\u043e\u043f\u043e\u043c\u043e\u0436\u0435 \u043b\u044e\u0434\u044f\u043c \u0443 \u0432\u0430\u0448\u043e\u043c\u0443 \u043c\u0456\u0441\u0442\u0456 \u0437\u043d\u0430\u0439\u0442\u0438 \u0432\u0430\u0448\u0443 \u0447\u0438\u0442\u0430\u0446\u044c\u043a\u0443 \u0433\u0440\u0443\u043f\u0443","This will help us create studies perfect for your group":"\u0426\u0435 \u0434\u043e\u043f\u043e\u043c\u043e\u0436\u0435 \u043d\u0430\u043c \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f, \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u0456 \u0434\u043b\u044f \u0432\u0430\u0448\u043e\u0457 \u0433\u0440\u0443\u043f\u0438!","Title your text entry":"\u0414\u0430\u0439\u0442\u0435 \u043d\u0430\u0437\u0432\u0443 \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u043e\u043c\u0443 \u0437\u0430\u043f\u0438\u0441\u0443","Title your video":"\u0414\u0430\u0439\u0442\u0435 \u043d\u0430\u0437\u0432\u0443 \u0441\u0432\u043e\u0454\u043c\u0443 \u0432\u0456\u0434\u0435\u043e",To:"\u0434\u043e","To fully delete your account we need you to login again":"\u0429\u043e\u0431 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0432\u0430\u0448 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441, \u043d\u0430\u043c \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e, \u0449\u043e\u0431 \u0432\u0438 \u0437\u043d\u043e\u0432\u0443 \u0443\u0432\u0456\u0439\u0448\u043b\u0438.",Todo:"\u0417\u0440\u043e\u0431\u0438\u0442\u0438","Try again":"\u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0437\u043d\u043e\u0432\u0443","Turn reminder off":"\u0412\u0438\u043c\u043a\u043d\u0443\u0442\u0438 \u043d\u0430\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f","Type a message":"\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f...","Type a verse range":"\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0432\u0456\u0440\u0448\u043e\u0432\u0438\u0439 \u0440\u044f\u0434","Unable to save your process":{" Do you want to back":"\u041d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0432\u0430\u0448 \u043f\u0440\u043e\u0446\u0435\u0441.\n\u0425\u043e\u0447\u0435\u0448 \u043d\u0430\u0437\u0430\u0434?"},"Unable to save your selection":"\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0432\u0430\u0448 \u0432\u0438\u0431\u0456\u0440!",Unknown:"\u041d\u0435\u0432\u0456\u0434\u043e\u043c\u0438\u0439","Unmute notifications":"\u0423\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 \u0441\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f",Unread:"\u041d\u0435\u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043d\u0438\u0439","Untitled day":"\u0414\u0435\u043d\u044c \u0431\u0435\u0437 \u043d\u0430\u0437\u0432\u0438","Untitled plan":"\u041f\u043b\u0430\u043d \u0431\u0435\u0437 \u043d\u0430\u0437\u0432\u0438",Upcoming:"\u041c\u0430\u0439\u0431\u0443\u0442\u043d\u0456","Update card":"\u041e\u043d\u043e\u0432\u0438\u0442\u0438 \u043a\u0430\u0440\u0442\u043a\u0443","Update contact info":"\u041e\u043d\u043e\u0432\u0456\u0442\u044c \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043d\u0443 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e","Update group name success":"\u0423\u0441\u043f\u0456\u0448\u043d\u0435 \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0437\u0432\u0438 \u0433\u0440\u0443\u043f\u0438","Update profile":"\u041e\u043d\u043e\u0432\u0438\u0442\u0438 \u043f\u0440\u043e\u0444\u0456\u043b\u044c",Upgrade:"\u041e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f","Use an existing plan or create a new plan from scratch":"\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043d\u0430\u044f\u0432\u043d\u0438\u0439 \u043f\u043b\u0430\u043d \u0430\u0431\u043e \u0441\u0442\u0432\u043e\u0440\u0456\u0442\u044c a\n\u043d\u043e\u0432\u0438\u0439 \u043f\u043b\u0430\u043d \u0437 \u043d\u0443\u043b\u044f \ud83c\udfa8","Use this plan":"\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0446\u0435\u0439 \u043f\u043b\u0430\u043d",Video:"\u0432\u0456\u0434\u0435\u043e",View:"\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438","View action":"\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u0434\u0456\u044e","View all entries":"\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438","View all prayers":"\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u0432\u0441\u0456 \u043c\u043e\u043b\u0438\u0442\u0432\u0438","View campaign":"\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u043a\u0430\u043c\u043f\u0430\u043d\u0456\u044e","View discussion":"\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u043e\u0431\u0433\u043e\u0432\u043e\u0440\u0435\u043d\u043d\u044f","View entry":"\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u0437\u0430\u043f\u0438\u0441","View more":"\u0414\u0438\u0432\u0438\u0442\u0438\u0441\u044c \u0431\u0456\u043b\u044c\u0448\u0435...","View prayer":"\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u043c\u043e\u043b\u0438\u0442\u0432\u0443","View previous prayers":"\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u044c\u0442\u0435 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456 \u043c\u043e\u043b\u0438\u0442\u0432\u0438, \u0437\u0430\u043f\u0438\u0441\u0438 \u043f\u043e\u0434\u044f\u043a\u0438 \u0442\u0430 \u043e\u0431\u0433\u043e\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u043d\u0438\u0436\u0447\u0435.","View reward":"\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u043c\u043e\u044e \u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0443 \u0437\u0430 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f","View todays study":"\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u044c\u0442\u0435 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456\u0448\u043d\u0454 \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f","We created this plan for your group":"\u041c\u0438 \u0441\u0442\u0432\u043e\u0440\u0438\u043b\u0438 \u0446\u0435\u0439 \u043f\u043b\u0430\u043d\n \u0434\u043b\u044f \u0432\u0430\u0448\u043e\u0457 \u0433\u0440\u0443\u043f\u0438 \u2728","We stay in touch":"\u041c\u0438 \u0437\u0430\u043b\u0438\u0448\u0430\u0454\u043c\u043e\u0441\u044f \u043d\u0430 \u0437\u0432'\u044f\u0437\u043a\u0443","We will be discussing these questions":"\u041c\u0438 \u0431\u0443\u0434\u0435\u043c\u043e \u043e\u0431\u0433\u043e\u0432\u043e\u0440\u044e\u0432\u0430\u0442\u0438 \u0446\u0456 \u043f\u0438\u0442\u0430\u043d\u043d\u044f","We will make sure to take it easy on the weekends":"\u041c\u0438 \u043f\u043e\u0434\u0431\u0430\u0454\u043c\u043e \u043f\u0440\u043e \u0442\u0435, \u0449\u043e\u0431 \u0432\u0438\u0445\u0456\u0434\u043d\u0456 \u043f\u0440\u043e\u0439\u0448\u043b\u0438 \u043b\u0435\u0433\u043a\u043e!","We will queue this up for your group":"\u041c\u0438 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043c\u043e \u0446\u0435 \u0432 \u0447\u0435\u0440\u0433\u0443 \u0434\u043b\u044f \u0432\u0430\u0448\u043e\u0457 \u0433\u0440\u0443\u043f\u0438",Week:"\u0442\u0438\u0436\u0434\u0435\u043d\u044c","Weekly review":"\u0429\u043e\u0442\u0438\u0436\u043d\u0435\u0432\u0438\u0439 \u043e\u0433\u043b\u044f\u0434",Welcome:"\u041b\u0435\u0433\u0448\u0435 \u0432\u0438\u0440\u043e\u0431\u0438\u0442\u0438 \u0431\u0456\u0431\u043b\u0456\u0439\u043d\u0443 \u0437\u0432\u0438\u0447\u043a\u0443\n\u043a\u043e\u043b\u0438 \u043c\u0438 \u0440\u043e\u0431\u0438\u043c\u043e \u0446\u0435 \u0440\u0430\u0437\u043e\u043c","Welcome back":"\u0417 \u043f\u043e\u0432\u0435\u0440\u043d\u0435\u043d\u043d\u044f\u043c!","Welcome home":"\u041b\u0430\u0441\u043a\u0430\u0432\u043e \u043f\u0440\u043e\u0441\u0438\u043c\u043e \u0434\u043e \u0434\u043e\u043c\u0443","Welcome to BibleDept":"\u0412\u0456\u0442\u0430\u0454\u043c\u043e \u0432 {{org_name}}!","Welcome to the group":"\u041b\u0430\u0441\u043a\u0430\u0432\u043e \u043f\u0440\u043e\u0441\u0438\u043c\u043e \u0432 \u0433\u0440\u0443\u043f\u0443!","What are you thankful to God for today":"\u0417\u0430 \u0449\u043e \u0432\u0438 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456 \u0432\u0434\u044f\u0447\u043d\u0456 \u0411\u043e\u0433\u043e\u0432\u0456?","What do people call you":"\u042f\u043a \u0442\u0435\u0431\u0435 \u043d\u0430\u0437\u0438\u0432\u0430\u044e\u0442\u044c?","What do you need prayer for today":"\u041f\u0440\u043e \u0449\u043e \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u0430 \u043c\u043e\u043b\u0438\u0442\u0432\u0430?","What would you like your group to pray for":"\u041f\u0440\u043e \u0449\u043e \u0431 \u0432\u0438 \u0445\u043e\u0442\u0456\u043b\u0438, \u0449\u043e\u0431 \u0432\u0430\u0448\u0430 \u0433\u0440\u0443\u043f\u0430 \u043c\u043e\u043b\u0438\u043b\u0430\u0441\u044f?","When do you want to start":"\ud83d\uddd3 \u041a\u043e\u043b\u0438 \u0442\u0438 \u0445\u043e\u0447\u0435\u0448 \u043f\u043e\u0447\u0430\u0442\u0438?","Which best describes you":"\u0429\u043e \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0435 \u043e\u043f\u0438\u0441\u0443\u0454 \u0432\u0430\u0441?","Who are you thankful for this week and why":"\u041a\u043e\u043c\u0443 \u0432\u0438 \u0432\u0434\u044f\u0447\u043d\u0456 \u0446\u044c\u043e\u0433\u043e \u0442\u0438\u0436\u043d\u044f \u0456 \u0447\u043e\u043c\u0443?","Who is your group made up of":"\ud83d\udc65 \u0417 \u043a\u043e\u0433\u043e \u0441\u043a\u043b\u0430\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u0432\u0430\u0448\u0430 \u0433\u0440\u0443\u043f\u0430?","Why are you creating group":"\ud83d\ude4f \u0427\u043e\u043c\u0443 \u0432\u0438 \u0441\u0442\u0432\u043e\u0440\u044e\u0454\u0442\u0435 \u0433\u0440\u0443\u043f\u0443?","Wow sounds great":"\u0412\u0430\u0443, \u0437\u0432\u0443\u0447\u0438\u0442\u044c \u0447\u0443\u0434\u043e\u0432\u043e!","Write a gratitude prompt":"\u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u043f\u043e\u0434\u044f\u043a\u0443\u2026","Write a prayer prompt":"\u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u043c\u043e\u043b\u0438\u0442\u043e\u0432\u043d\u0435 \u0441\u043f\u043e\u043d\u0443\u043a\u0430\u043d\u043d\u044f\u2026","Write a prompt":"\u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u043f\u0456\u0434\u043a\u0430\u0437\u043a\u0443","Write a prompt for your group to answer":"\u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u043f\u0456\u0434\u043a\u0430\u0437\u043a\u0443, \u0449\u043e\u0431 \u0432\u0430\u0448\u0430 \u0433\u0440\u0443\u043f\u0430 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u043b\u0430 \ud83d\udc47","Write a question":"\u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f","Write an action":"\u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u0434\u0456\u044e","Write description here":"\u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u0442\u0443\u0442 \u043e\u043f\u0438\u0441...","Write my own question":"\u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u043c\u043e\u0454 \u0432\u043b\u0430\u0441\u043d\u0435 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f","Write out or paste your text entry below":"\u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u0430\u0431\u043e \u0432\u0441\u0442\u0430\u0432\u0442\u0435 \u0441\u0432\u0456\u0439 \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u043d\u0438\u0436\u0447\u0435 \ud83d\udc47","Write your own":"\u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u0432\u043b\u0430\u0441\u043d\u0438\u0439...","Write your own action here":"\u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u0442\u0443\u0442 \u0441\u0432\u043e\u044e \u0434\u0456\u044e","Write your own question here":"\u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u0432\u043b\u0430\u0441\u043d\u0435 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u0442\u0443\u0442",Yes:"\u0422\u0430\u043a","Yes I want to help":"\u0422\u0430\u043a, \u044f \u0445\u043e\u0447\u0443 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438!","Yes continue":"\u0422\u0430\u043a, \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0443\u0432\u0430\u0442\u0438","Yes delete":"\u0422\u0430\u043a, \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u0438","Yes replace it":"\u0422\u0430\u043a, \u0437\u0430\u043c\u0456\u043d\u0456\u0442\u044c",You:"\u0442\u0438","You are about to lose your streak":"\ud83d\udd25 \u0412\u0438 \u0441\u043a\u043e\u0440\u043e \u0432\u0442\u0440\u0430\u0442\u0438\u0442\u0435 \u0441\u0432\u043e\u044e \u0441\u0435\u0440\u0456\u044e","You are already a part of":"\u0412\u0438 \u0432\u0436\u0435 \u0454 \u0447\u0430\u0441\u0442\u0438\u043d\u043e\u044e","You are already part of another organisation and cannot accept this invite":"\u0412\u0438 \u0432\u0436\u0435 \u0454 \u0447\u043b\u0435\u043d\u043e\u043c \u0456\u043d\u0448\u043e\u0457 \u043e\u0440\u0433\u0430\u043d\u0456\u0437\u0430\u0446\u0456\u0457 \u0442\u0430 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0440\u0438\u0439\u043d\u044f\u0442\u0438 \u0446\u0435 \u0437\u0430\u043f\u0440\u043e\u0448\u0435\u043d\u043d\u044f.","You are doing a great job":"\u0412\u0438 \u0440\u043e\u0431\u0438\u0442\u0435 \u0447\u0443\u0434\u043e\u0432\u0443 \u0440\u043e\u0431\u043e\u0442\u0443","You are in another organization":"\u0412\u0438 \u0432 \u0456\u043d\u0448\u0456\u0439 \u043e\u0440\u0433\u0430\u043d\u0456\u0437\u0430\u0446\u0456\u0457.","You can always change goals later":"\u0417\u0430\u0432\u0436\u0434\u0438 \u043c\u043e\u0436\u043d\u0430\n\u0437\u043c\u0456\u043d\u0438\u0442\u0438 \u0441\u0432\u043e\u044e \u043c\u0435\u0442\u0443 \u043f\u0456\u0437\u043d\u0456\u0448\u0435","You have been invited to":"\u0412\u0430\u0441 \u0437\u0430\u043f\u0440\u043e\u0441\u0438\u043b\u0438 \u043d\u0430","You have created":"\u0412\u0438 \u0441\u0442\u0432\u043e\u0440\u0438\u043b\u0438","You have no action steps":"\u0423 \u0432\u0430\u0441 \u043d\u0435\u043c\u0430\u0454 \u0434\u0456\u0439!","You have no entries":"\u0423 \u0432\u0430\u0441 \u043d\u0435\u043c\u0430\u0454 \u0437\u0430\u043f\u0438\u0441\u0456\u0432!","You have no messages":"\u0423 \u0432\u0430\u0441 \u043d\u0435\u043c\u0430\u0454 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u044c!","You have no plans":"\u0423 \u0432\u0430\u0441 \u043d\u0435\u043c\u0430\u0454 \u043f\u043b\u0430\u043d\u0456\u0432","You have no prayers":"\u0423 \u0432\u0430\u0441 \u043d\u0435\u043c\u0430\u0454 \u043c\u043e\u043b\u0438\u0442\u043e\u0432!","You have no prayers!":"\u0423 \u0432\u0430\u0441 \u043d\u0435\u043c\u0430\u0454 \u043c\u043e\u043b\u0438\u0442\u043e\u0432!","You reached your daily goal":"\u0412\u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b\u0438 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456\u0448\u043d\u0454 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f!","You replied to gratitude":"\u0412\u0438 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u043b\u0438 \u043d\u0430 \u043f\u043e\u0434\u044f\u043a\u0443 {{nameValue}}","You replied to prayer":"\u0412\u0438 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u043b\u0438 \u043d\u0430 \u043c\u043e\u043b\u0438\u0442\u0432\u0443 {{nameValue}}","Your content is empty":"\u0412\u0430\u0448 \u0432\u043c\u0456\u0441\u0442 \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u0439!","Your current study is almost finished":{" Let is queue up the next one":"\u0412\u0430\u0448\u0435 \u043f\u043e\u0442\u043e\u0447\u043d\u0435 \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f \u043c\u0430\u0439\u0436\u0435 \u0437\u0430\u043a\u0456\u043d\u0447\u0435\u043d\u043e. \u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0432 \u0447\u0435\u0440\u0433\u0443 \u0434\u043e \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u043e\u0433\u043e!"},"Your gift amount":"\u0421\u0443\u043c\u0430 \u0432\u0430\u0448\u043e\u0433\u043e \u043f\u043e\u0434\u0430\u0440\u0443\u043d\u043a\u0430:","Your gratitude entry":"\u0412\u0430\u0448\u0430 \u0437\u0430\u043f\u0438\u0441 \u043f\u043e\u0434\u044f\u043a\u0438","Your group is good to go":"\u0412\u0430\u0448\u0430 \u0433\u0440\u0443\u043f\u0430 \u0433\u043e\u0442\u043e\u0432\u0430! \u2728","Your group s action steps will appear here":"\u0422\u0443\u0442 \u0437\u2019\u044f\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u0434\u0456\u0457 \u0432\u0430\u0448\u043e\u0457 \u0433\u0440\u0443\u043f\u0438","Your plan was created":"\u0412\u0430\u0448 \u043f\u043b\u0430\u043d \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043e!","Your prayer request":"\u0412\u0430\u0448\u0435 \u043c\u043e\u043b\u0438\u0442\u043e\u0432\u043d\u0435 \u043f\u0440\u043e\u0445\u0430\u043d\u043d\u044f","Your selected start date overlaps with a future study":{" Do you want to replace that future study":"\u0412\u0438\u0431\u0440\u0430\u043d\u0430 \u0432\u0430\u043c\u0438 \u0434\u0430\u0442\u0430 \u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0437\u0431\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u0437 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u0456\u043c \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f\u043c. \u0412\u0438 \u0445\u043e\u0447\u0435\u0442\u0435 \u0437\u0430\u043c\u0456\u043d\u0438\u0442\u0438 \u0446\u0435 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u0454 \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f?"},"Your selected start date overlaps with your current study":{" Do you want to replace your current study":"\u0412\u0438\u0431\u0440\u0430\u043d\u0430 \u0432\u0430\u043c\u0438 \u0434\u0430\u0442\u0430 \u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0437\u0431\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u0437 \u043f\u043e\u0442\u043e\u0447\u043d\u0438\u043c \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f\u043c. \u0412\u0438 \u0445\u043e\u0447\u0435\u0442\u0435 \u0437\u0430\u043c\u0456\u043d\u0438\u0442\u0438 \u0441\u0432\u043e\u0454 \u043f\u043e\u0442\u043e\u0447\u043d\u0435 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f?"},"Youtube url is not correct please check again":"URL-\u0430\u0434\u0440\u0435\u0441\u0430 Youtube \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0430, \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437!","Youve been invited to create a":"\u0412\u0430\u0441 \u0437\u0430\u043f\u0440\u043e\u0441\u0438\u043b\u0438 \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438",action_step_choose_duration_desc:"\u042f\u043a \u0434\u043e\u0432\u0433\u043e \u0432\u0438 \u0431\u0430\u0436\u0430\u0454\u0442\u0435, \u0449\u043e\u0431 \u0446\u044f \u0434\u0456\u044f \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u043b\u0430\u0441\u044f \u043d\u0430 \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u043c\u0443 \u0435\u043a\u0440\u0430\u043d\u0456? \u0422\u043e\u0440\u043a\u043d\u0456\u0442\u044c\u0441\u044f \u043d\u0438\u0436\u0447\u0435, \u0449\u043e\u0431 \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \ud83d\udc47",action_steps_descriptions:"\u0415\u0442\u0430\u043f\u0438 \u0434\u0456\u0439 \u2014 \u0446\u0435 \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u0438\u0439 \u0441\u043f\u043e\u0441\u0456\u0431 \u0437\u0430\u043e\u0445\u043e\u0442\u0438\u0442\u0438 \u0441\u0432\u043e\u044e \u0433\u0440\u0443\u043f\u0443 \u0434\u043e \u0436\u0438\u0442\u0442\u044f.\n\n\u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u043f\u0440\u043e\u043f\u043e\u043d\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043e\u0457\u043c \u0447\u043b\u0435\u043d\u0430\u043c \u0437\u0434\u0456\u0439\u0441\u043d\u0438\u0442\u0438 \u043c\u043e\u043b\u0438\u0442\u043e\u0432\u043d\u0443 \u043f\u0440\u043e\u0433\u0443\u043b\u044f\u043d\u043a\u0443 \u0430\u0431\u043e \u043f\u043e\u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0438 \u0437 \u0441\u0443\u0441\u0456\u0434\u043e\u043c \u0456 \u043f\u043e\u0434\u0456\u043b\u0438\u0442\u0438\u0441\u044f, \u044f\u043a \u0432\u0441\u0435 \u043f\u0440\u043e\u0439\u0448\u043b\u043e.\n\n\u0422\u043e\u0440\u043a\u043d\u0456\u0442\u044c\u0441\u044f \u043d\u0438\u0436\u0447\u0435, \u0449\u043e\u0431 \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u0438 \u0441\u0432\u0456\u0439 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 \u043a\u0440\u043e\u043a, \u0456 \u043c\u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u043c\u043e \u0439\u043e\u0433\u043e \u0432\u0430\u0448\u0456\u0439 \u0433\u0440\u0443\u043f\u0456! \ud83d\udc47",activity:"\u0434\u0456\u044f\u043b\u044c\u043d\u0456\u0441\u0442\u044c",add_gratitude_description:"\u041c\u0438 \u0440\u043e\u0437\u043f\u043e\u0432\u0441\u044e\u0434\u0438\u043c\u043e \u0446\u0456 \u043f\u0456\u0434\u043a\u0430\u0437\u043a\u0438 \u0432\u0434\u044f\u0447\u043d\u043e\u0441\u0442\u0456 \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c \u0432\u0430\u0448\u043e\u0433\u043e \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f, \u0449\u043e\u0431 \u0432\u0456\u0434\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u043a\u0440\u0443\u0442\u0456 \u0440\u0435\u0447\u0456, \u044f\u043a\u0456 \u0411\u043e\u0433 \u0440\u043e\u0431\u0438\u0442\u044c \u0443 \u0457\u0445\u043d\u044c\u043e\u043c\u0443 \u0436\u0438\u0442\u0442\u0456. \u26a1\ufe0f",add_prayer_description:"\u041c\u0438 \u0440\u043e\u0437\u0441\u0438\u043f\u0430\u0442\u0438\u043c\u0435\u043c\u043e \u0446\u0456 \u043c\u043e\u043b\u0438\u0442\u043e\u0432\u043d\u0456 \u043f\u0456\u0434\u043a\u0430\u0437\u043a\u0438 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0432\u0430\u0448\u043e\u0433\u043e \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f, \u0449\u043e\u0431 \u0437\u0431\u043b\u0438\u0437\u0438\u0442\u0438 \u0432\u0430\u0448\u0443 \u0433\u0440\u0443\u043f\u0443. \u2728",add_question_description:"\u0417\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u0434\u0430\u044e\u0442\u044c \u0447\u0443\u0434\u043e\u0432\u0443 \u043c\u043e\u0436\u043b\u0438\u0432\u0456\u0441\u0442\u044c \u0434\u043b\u044f \u0432\u0430\u0448\u043e\u0457 \u0433\u0440\u0443\u043f\u0438 \u0449\u043e\u0434\u043d\u044f \u0440\u043e\u0437\u043c\u0456\u0440\u043a\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0440\u0430\u0437\u043e\u043c. \u2728\n\n\u0411\u0430\u0436\u0430\u0454\u0442\u0435 \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u043e\u0434\u043d\u0435 \u0437 \u043d\u0430\u0448\u0438\u0445 \u0433\u043e\u0442\u043e\u0432\u0438\u0445 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u044c \u0447\u0438 \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0435?",add_text_description:"\u0412\u0430\u0448\u0456 \u0443\u0447\u0430\u0441\u043d\u0438\u043a\u0438 \u0431\u0430\u0447\u0438\u0442\u0438\u043c\u0443\u0442\u044c \u0446\u0435\u0439 \u0442\u0435\u043a\u0441\u0442 \u0443 \u0434\u043e\u0434\u0430\u0442\u043a\u0443 \u044f\u043a \u043e\u0434\u043d\u0435 \u0437\u0456 \u0441\u0432\u043e\u0457\u0445 \u0449\u043e\u0434\u0435\u043d\u043d\u0438\u0445 \u043d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u0438\u0445 \u0437\u0430\u043d\u044f\u0442\u044c.\n\n\u0426\u0435 \u0447\u0443\u0434\u043e\u0432\u043e \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0449\u043e\u0431 \u043f\u043e\u0434\u0456\u043b\u0438\u0442\u0438\u0441\u044f \u0441\u0432\u043e\u0457\u043c\u0438 \u0434\u0443\u043c\u043a\u0430\u043c\u0438 \u0430\u0431\u043e \u0441\u043a\u0435\u0440\u0443\u0432\u0430\u0442\u0438 \u0447\u043b\u0435\u043d\u0456\u0432.\ud83d\udca1 \u0414\u0435\u044f\u043a\u0456 \u0447\u0443\u0434\u043e\u0432\u0456 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u0438 \u2013 \u0446\u0435 \u043a\u043e\u0440\u043e\u0442\u043a\u0430 \u043c\u043e\u043b\u0438\u0442\u0432\u0430, \u0456\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0456\u0457 \u0434\u043b\u044f \u043c\u043e\u043b\u0438\u0442\u043e\u0432\u043d\u043e\u0457 \u043c\u0435\u0434\u0438\u0442\u0430\u0446\u0456\u0457 \u0430\u0431\u043e \u0432\u0438\u043a\u043b\u0438\u043a \u0434\u043b\u044f \u0432\u0430\u0448\u0438\u0445 \u0443\u0447\u0430\u0441\u043d\u0438\u043a\u0456\u0432.",add_video_description:"\u0414\u043e\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0432\u0456\u0434\u0435\u043e \u2013 \u0447\u0443\u0434\u043e\u0432\u0438\u0439 \u0441\u043f\u043e\u0441\u0456\u0431 \u0434\u043e\u043f\u043e\u0432\u043d\u0438\u0442\u0438 \u0432\u0430\u0448\u0435 \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f. \u041c\u0438 \u0432\u0438\u044f\u0432\u0438\u043b\u0438, \u0449\u043e \u0446\u0435 \u043c\u043e\u0436\u0435 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u0432\u0430\u0448\u0456\u0439 \u0433\u0440\u0443\u043f\u0456 \u043a\u0440\u0430\u0449\u0435 \u0437\u0440\u043e\u0437\u0443\u043c\u0456\u0442\u0438, \u0449\u043e \u0432\u043e\u043d\u0438 \u0432\u0438\u0432\u0447\u0430\u044e\u0442\u044c, \u043d\u0435\u0437\u0430\u043b\u0435\u0436\u043d\u043e \u0432\u0456\u0434 \u0442\u043e\u0433\u043e, \u0447\u0438 \u0446\u0435 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456, \u0447\u0438 \u043c\u043e\u043b\u0438\u0442\u0432\u0430, \u044f\u043a\u0443 \u0432\u0438 \u0437\u043d\u0456\u043c\u0430\u0454\u0442\u0435 \u0441\u0430\u043c\u0456.\n\n\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \xab\u0414\u0430\u043b\u0456\xbb, \u0449\u043e\u0431 \u0434\u043e\u0434\u0430\u0442\u0438 \u0432\u0456\u0434\u0435\u043e \u0434\u043e \u0441\u0432\u043e\u0433\u043e \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f \ud83d\udc47","already have account":"\u0412\u0436\u0435 \u0454 \u0430\u043a\u043a\u0430\u0443\u043d\u0442?",back:"\u043d\u0430\u0437\u0430\u0434","back block":"\u0412\u0438 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0456, \u0449\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u0438\u0441\u044f?\n\u0412\u0430\u0448\u0456 \u0437\u043c\u0456\u043d\u0438 \u043d\u0435 \u0431\u0443\u0434\u0443\u0442\u044c \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0456!","bible complete message":" \ud83c\udf89 \u0412\u0438 \u0446\u0435 \u0437\u0440\u043e\u0431\u0438\u043b\u0438! \u0412\u0438 \u0437\u0430\u043a\u0456\u043d\u0447\u0438\u043b\u0438 \u201c%{name}\u201d","bible completed":"\u0412\u0438\u0432\u0447\u0435\u043d\u043d\u044f \u0411\u0456\u0431\u043b\u0456\u0457 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043e!",build_habit_content:"\u0417 {{org_name}} \u0432\u0438 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0435, \u043d\u0430\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u043b\u0435\u0433\u043a\u043e \u0441\u0442\u0430\u0454 \u0447\u0438\u0442\u0430\u043d\u043d\u044f \u0411\u0456\u0431\u043b\u0456\u0457, \u043a\u043e\u043b\u0438 \u0443 \u0432\u0430\u0441 \u0454 \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0430, \u044f\u043a\u0430 \u043c\u043e\u0442\u0438\u0432\u0443\u0454 \u0442\u0430 \u0437\u0430\u043e\u0445\