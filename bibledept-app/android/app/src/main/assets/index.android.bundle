6\u05d5 \u05ea\u05de\u05d7\u05e7 \u05d0\u05ea \u05db\u05dc \u05d4\u05de\u05d9\u05d3\u05e2 \u05d4\u05e9\u05de\u05d5\u05e8 \u05e2\u05d1\u05d5\u05e8 {{brand}} \u05d6\u05d4 \u05d4\u05de\u05e1\u05ea\u05d9\u05d9\u05dd \u05d1-{{last4}}","This helps us find people just like you":"\u05d6\u05d4 \u05e2\u05d5\u05d6\u05e8 \u05dc\u05e0\u05d5 \u05dc\u05de\u05e6\u05d5\u05d0\n\u05d0\u05e0\u05e9\u05d9\u05dd \u05d1\u05d3\u05d9\u05d5\u05e7 \u05db\u05de\u05d5\u05da.","This invite may have expired":"\u05d9\u05d9\u05ea\u05db\u05df \u05e9\u05e4\u05d2 \u05ea\u05d5\u05e7\u05e4\u05d5 \u05e9\u05dc \u05d4\u05d6\u05de\u05e0\u05d4 \u05d6\u05d5, \u05d0\u05d5\n\u05d0\u05d5\u05dc\u05d9 \u05d0\u05d9\u05df \u05dc\u05da \u05d4\u05e8\u05e9\u05d0\u05d4 \u05dc\u05db\u05da\n\u05d4\u05e6\u05d8\u05e8\u05e3 \u05dc\u05e7\u05d1\u05d5\u05e6\u05d4...","This video explains how you can get the most out of BibleDept":"\u05d4\u05e1\u05e8\u05d8\u05d5\u05df \u05d4\u05d6\u05d4 \u05de\u05e1\u05d1\u05d9\u05e8 \u05d0\u05d9\u05da \u05d0\u05ea\u05d4 \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05e9\u05d9\u05d2 \u05d0\u05ea\n\u05d4\u05db\u05d9 \u05d4\u05e8\u05d1\u05d4 \u05de\u05ea\u05d5\u05da {{org_name}}","This weeks most active members were":"\u05d4\u05d7\u05d1\u05e8\u05d9\u05dd \u05d4\u05e4\u05e2\u05d9\u05dc\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05d4\u05e9\u05d1\u05d5\u05e2\\n \u05d4\u05d9\u05d5...\u26a1\ufe0f","This will help people in your city find your reading group":"\u05d6\u05d4 \u05d9\u05e2\u05d6\u05d5\u05e8 \u05dc\u05d0\u05e0\u05e9\u05d9\u05dd \u05d1\u05e2\u05d9\u05e8 \u05e9\u05dc\u05da \u05dc\u05de\u05e6\u05d5\u05d0 \u05d0\u05ea \u05e7\u05d1\u05d5\u05e6\u05ea \u05d4\u05e7\u05e8\u05d9\u05d0\u05d4 \u05e9\u05dc\u05da","This will help us create studies perfect for your group":"\u05d6\u05d4 \u05d9\u05e2\u05d6\u05d5\u05e8 \u05dc\u05e0\u05d5 \u05dc\u05d9\u05e6\u05d5\u05e8 \u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd \u05de\u05d5\u05e9\u05dc\u05de\u05d9\u05dd \u05e2\u05d1\u05d5\u05e8 \u05d4\u05e7\u05d1\u05d5\u05e6\u05d4 \u05e9\u05dc\u05da!","Title your text entry":"\u05ea\u05df \u05db\u05d5\u05ea\u05e8\u05ea \u05dc\u05e8\u05e9\u05d5\u05de\u05ea \u05d4\u05d8\u05e7\u05e1\u05d8 \u05e9\u05dc\u05da","Title your video":"\u05ea\u05df \u05db\u05d5\u05ea\u05e8\u05ea \u05dc\u05e1\u05e8\u05d8\u05d5\u05df \u05e9\u05dc\u05da",To:"\u05dc","To fully delete your account we need you to login again":"\u05db\u05d3\u05d9 \u05dc\u05de\u05d7\u05d5\u05e7 \u05d0\u05ea \u05d7\u05e9\u05d1\u05d5\u05e0\u05da \u05d1\u05de\u05dc\u05d5\u05d0\u05d4, \u05d0\u05e0\u05d5 \u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05e9\u05ea\u05ea\u05d7\u05d1\u05e8 \u05e9\u05d5\u05d1.",Todo:"\u05dc\u05e2\u05e9\u05d5\u05ea","Try again":"\u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1","Turn reminder off":"\u05db\u05d1\u05d4 \u05d0\u05ea \u05d4\u05ea\u05d6\u05db\u05d5\u05e8\u05ea","Type a message":"\u05d4\u05e7\u05dc\u05d3 \u05d4\u05d5\u05d3\u05e2\u05d4...","Type a verse range":"\u05d4\u05e7\u05dc\u05d3 \u05d8\u05d5\u05d5\u05d7 \u05e4\u05e1\u05d5\u05e7\u05d9\u05dd","Unable to save your process":{" Do you want to back":"\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05e9\u05de\u05d5\u05e8 \u05d0\u05ea \u05d4\u05ea\u05d4\u05dc\u05d9\u05da \u05e9\u05dc\u05da.\n\u05d4\u05d0\u05dd \u05d0\u05ea\u05d4 \u05e8\u05d5\u05e6\u05d4 \u05dc\u05d7\u05d6\u05d5\u05e8?"},"Unable to save your selection":"\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05e9\u05de\u05d5\u05e8 \u05d0\u05ea \u05d4\u05d1\u05d7\u05d9\u05e8\u05d4 \u05e9\u05dc\u05da!",Unknown:"\u05dc\u05d0 \u05d9\u05d3\u05d5\u05e2","Unmute notifications":"\u05d1\u05d8\u05dc \u05d4\u05e9\u05ea\u05e7\u05ea \u05d4\u05d5\u05d3\u05e2\u05d5\u05ea",Unread:"\u05dc\u05d0 \u05e0\u05e7\u05e8\u05d0","Untitled day":"\u05d9\u05d5\u05dd \u05dc\u05dc\u05d0 \u05db\u05d5\u05ea\u05e8\u05ea","Untitled plan":"\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05dc\u05dc\u05d0 \u05db\u05d5\u05ea\u05e8\u05ea",Upcoming:"\u05d1\u05e7\u05e8\u05d5\u05d1","Update card":"\u05e2\u05d3\u05db\u05d5\u05df \u05db\u05e8\u05d8\u05d9\u05e1","Update contact info":"\u05e2\u05d3\u05db\u05df \u05d0\u05ea \u05e4\u05e8\u05d8\u05d9 \u05d4\u05e7\u05e9\u05e8","Update group name success":"\u05e2\u05d3\u05db\u05d5\u05df \u05e9\u05dd \u05d4\u05e7\u05d1\u05d5\u05e6\u05d4 \u05d4\u05e6\u05dc\u05d9\u05d7","Update profile":"\u05e2\u05d3\u05db\u05df \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc",Upgrade:"\u05e9\u05d3\u05e8\u05d5\u05d2","Use an existing plan or create a new plan from scratch":"\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05e7\u05d9\u05d9\u05de\u05ea \u05d0\u05d5 \u05e6\u05d5\u05e8 \u05d0\n\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d7\u05d3\u05e9\u05d4 \u05de\u05d0\u05e4\u05e1 \ud83c\udfa8","Use this plan":"\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d6\u05d5",Video:"\u05d5\u05b4\u05d9\u05d3\u05b5\u05d0\u05d5\u05b9",View:"\u05e0\u05d5\u05e3","View action":"\u05d4\u05e6\u05d2 \u05e4\u05e2\u05d5\u05dc\u05d4","View all entries":"\u05d4\u05e6\u05d2 \u05d0\u05ea \u05db\u05dc \u05d4\u05e2\u05e8\u05db\u05d9\u05dd","View all prayers":"\u05e6\u05e4\u05d4 \u05d1\u05db\u05dc \u05d4\u05ea\u05e4\u05d9\u05dc\u05d5\u05ea","View campaign":"\u05d4\u05e6\u05d2 \u05de\u05e1\u05e2 \u05e4\u05e8\u05e1\u05d5\u05dd","View discussion":"\u05e6\u05e4\u05d4 \u05d1\u05d3\u05d9\u05d5\u05df","View entry":"\u05e6\u05e4\u05d4 \u05d1\u05e2\u05e8\u05da","View more":"\u05e8\u05d0\u05d4 \u05e2\u05d5\u05d3...","View prayer":"\u05e6\u05e4\u05d5 \u05d1\u05ea\u05e4\u05d9\u05dc\u05d4","View previous prayers":"\u05e8\u05d0\u05d4 \u05dc\u05de\u05d8\u05d4 \u05ea\u05e4\u05d9\u05dc\u05d5\u05ea \u05e7\u05d5\u05d3\u05de\u05d5\u05ea, \u05e2\u05e8\u05db\u05d9 \u05d4\u05db\u05e8\u05ea \u05ea\u05d5\u05d3\u05d4 \u05d5\u05d3\u05d9\u05d5\u05e0\u05d9\u05dd.","View reward":"\u05e6\u05e4\u05d5 \u05d1\u05e4\u05e8\u05e1 \u05d4\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd \u05e9\u05dc\u05d9","View todays study":"\u05e6\u05e4\u05d5 \u05d1\u05de\u05d7\u05e7\u05e8 \u05e9\u05dc \u05d4\u05d9\u05d5\u05dd","We created this plan for your group":"\u05d9\u05e6\u05e8\u05e0\u05d5 \u05d0\u05ea \u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05d6\u05d5\n \u05dc\u05e7\u05d1\u05d5\u05e6\u05d4 \u05e9\u05dc\u05da \u2728","We stay in touch":"\u05d0\u05e0\u05d7\u05e0\u05d5 \u05e9\u05d5\u05de\u05e8\u05d9\u05dd \u05e2\u05dc \u05e7\u05e9\u05e8","We will be discussing these questions":"\u05d0\u05e0\u05d5 \u05e0\u05d3\u05d5\u05df \u05d1\u05e9\u05d0\u05dc\u05d5\u05ea \u05d0\u05dc\u05d5","We will make sure to take it easy on the weekends":"\u05d0\u05e0\u05d7\u05e0\u05d5 \u05e0\u05d3\u05d0\u05d2 \u05dc\u05e7\u05d7\u05ea \u05d0\u05ea \u05d6\u05d4 \u05d1\u05e7\u05dc\u05d5\u05ea \u05d1\u05e1\u05d5\u05e4\u05d9 \u05d4\u05e9\u05d1\u05d5\u05e2!","We will queue this up for your group":"\u05d0\u05e0\u05d7\u05e0\u05d5 \u05e0\u05e2\u05de\u05d9\u05d3 \u05d0\u05ea \u05d6\u05d4 \u05d1\u05ea\u05d5\u05e8 \u05dc\u05e7\u05d1\u05d5\u05e6\u05d4 \u05e9\u05dc\u05da",Week:"\u05e9\u05c1\u05b8\u05d1\u05d5\u05bc\u05e2\u05b7","Weekly review":"\u05e1\u05e7\u05d9\u05e8\u05d4 \u05e9\u05d1\u05d5\u05e2\u05d9\u05ea",Welcome:"\u05e7\u05dc \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d1\u05e0\u05d5\u05ea \u05d4\u05e8\u05d2\u05dc \u05ea\u05e0\"\u05da\n\u05db\u05e9\u05d0\u05e0\u05d7\u05e0\u05d5 \u05e2\u05d5\u05e9\u05d9\u05dd \u05d0\u05ea \u05d6\u05d4 \u05d1\u05d9\u05d7\u05d3","Welcome back":"\u05d1\u05e8\u05d5\u05da \u05e9\u05d5\u05d1\u05da!","Welcome home":"\u05d1\u05e8\u05d5\u05da \u05d4\u05d1\u05d0 \u05d4\u05d1\u05d9\u05ea\u05d4","Welcome to BibleDept":"\u05d1\u05e8\u05d5\u05db\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05d0\u05dc {{org_name}}!","Welcome to the group":"\u05d1\u05e8\u05d5\u05da \u05d4\u05d1\u05d0 \u05dc\u05e7\u05d1\u05d5\u05e6\u05d4!","What are you thankful to God for today":"\u05e2\u05dc \u05de\u05d4 \u05d0\u05ea\u05d4 \u05d0\u05e1\u05d9\u05e8 \u05ea\u05d5\u05d3\u05d4 \u05dc\u05d0\u05dc\u05d5\u05d4\u05d9\u05dd \u05d4\u05d9\u05d5\u05dd?","What do people call you":"\u05d0\u05d9\u05da \u05d0\u05e0\u05e9\u05d9\u05dd \u05e7\u05d5\u05e8\u05