44b, \u0447\u0442\u043e \u0445\u043e\u0442\u0438\u0442\u0435 \u0443\u0434\u0430\u043b\u0438\u0442\u044c \u044d\u0442\u043e\u0442 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440?","Are you sure you want to delete this group":"\u0412\u044b \u0443\u0432\u0435\u0440\u0435\u043d\u044b, \u0447\u0442\u043e \u0445\u043e\u0442\u0438\u0442\u0435 \u0443\u0434\u0430\u043b\u0438\u0442\u044c \u044d\u0442\u0443 \u0433\u0440\u0443\u043f\u043f\u0443?","Are you sure you want to delete this member":"\u0412\u044b \u0443\u0432\u0435\u0440\u0435\u043d\u044b, \u0447\u0442\u043e \u0445\u043e\u0442\u0438\u0442\u0435 \u0443\u0434\u0430\u043b\u0438\u0442\u044c \u044d\u0442\u043e\u0433\u043e \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0430?","Are you sure you want to leave this group":"\u0412\u044b \u0443\u0432\u0435\u0440\u0435\u043d\u044b, \u0447\u0442\u043e \u0445\u043e\u0442\u0438\u0442\u0435 \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u044c \u044d\u0442\u0443 \u0433\u0440\u0443\u043f\u043f\u0443?","Automatic Prayer and Gratitude":"\u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043c\u043e\u043b\u0438\u0442\u0432\u0430 \u0438 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u044c","Back to group":"\u0412\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u043a \u0433\u0440\u0443\u043f\u043f\u0435","Be on mission desc":"\u0414\u043e\u0441\u0442\u0443\u0447\u0430\u0442\u044c\u0441\u044f \u0434\u043e \u043c\u0438\u0440\u0430 \u0438 \u0432\u043b\u0438\u044f\u0442\u044c \u043d\u0430 \u043d\u0435\u0433\u043e, \u0441\u0442\u0440\u043e\u044f \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0446\u0435\u0440\u043a\u043e\u0432\u044c, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0443\u044e \u043d\u0430 \u0411\u0438\u0431\u043b\u0438\u0438, \u0432 \u0446\u0435\u043d\u0442\u0440\u0435 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0425\u0440\u0438\u0441\u0442\u043e\u0441, \u043c\u0435\u043d\u044f\u044f \u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0435 \u0438 \u0434\u0430\u0432\u0430\u044f \u043b\u044e\u0434\u044f\u043c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u0438 \u0432\u043b\u0438\u044f\u0442\u044c \u043d\u0430 \u0432\u0441\u0435 \u0441\u0444\u0435\u0440\u044b \u0436\u0438\u0437\u043d\u0438.","Be on mission with us":"\u0411\u0443\u0434\u044c\u0442\u0435 \u043d\u0430 \u043c\u0438\u0441\u0441\u0438\u0438 \u0441 \u043d\u0430\u043c\u0438","Bible study leader":"\ud83d\udcda \u0420\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f \u0411\u0438\u0431\u043b\u0438\u0438",Books:"\u041a\u043d\u0438\u0433\u0438","Build a Bible habit together":"\u0412\u044b\u0440\u0430\u0431\u043e\u0442\u0430\u0439\u0442\u0435 \u0431\u0438\u0431\u043b\u0435\u0439\u0441\u043a\u0443\u044e \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0443\n \u0432\u043c\u0435\u0441\u0442\u0435 \u26a1\ufe0f","Build a plan from scratch by selecting scripture and questions for your group":"\u0421\u043e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u043f\u043b\u0430\u043d \u0441 \u043d\u0443\u043b\u044f, \u0432\u044b\u0431\u0440\u0430\u0432 \u043e\u0442\u0440\u044b\u0432\u043a\u0438 \u0438\u0437 \u0421\u0432\u044f\u0449\u0435\u043d\u043d\u044b\u0445 \u041f\u0438\u0441\u0430\u043d\u0438\u0439 \u0438 \u0432\u043e\u043f\u0440\u043e\u0441\u044b \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u044b.","Build a plan from scratch by selecting various scriptures and activities for your group":"\u0421\u043e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u043f\u043b\u0430\u043d \u0441 \u043d\u0443\u043b\u044f, \u0432\u044b\u0431\u0440\u0430\u0432 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0435 \u043c\u0435\u0441\u0442\u0430 \u041f\u0438\u0441\u0430\u043d\u0438\u044f \u0438 \u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u044f \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u044b.","Build bible together":"\u0412\u043c\u0435\u0441\u0442\u0435 \u0432\u044b\u0440\u0430\u0431\u043e\u0442\u0430\u0439\u0442\u0435 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u0443\u044e \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0443 \u0447\u0438\u0442\u0430\u0442\u044c \u0411\u0438\u0431\u043b\u0438\u044e","Build bible together desc":"\u0412\u044b \u0443\u0432\u0438\u0434\u0438\u0442\u0435, \u043a\u0430\u043a \u043b\u0435\u0433\u043a\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0447\u0438\u0442\u0430\u0442\u044c \u0411\u0438\u0431\u043b\u0438\u044e, \u043a\u043e\u0433\u0434\u0430 \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043c\u043e\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442 \u0438 \u043e\u0431\u043e\u0434\u0440\u044f\u0435\u0442 \u0432\u0430\u0441 \u043d\u0430 \u044d\u0442\u043e\u043c \u043f\u0443\u0442\u0438 \u2014 \u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u043c\u0441\u044f!","Building a plan for your group":"\u0421\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u043d\u0430 \u0434\u043b\u044f \u0432\u0430\u0448\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u044b \u26a1\ufe0f","Building communities for college campus students":"\u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432 \u0434\u043b\u044f \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432 \u043a\u0430\u043c\u043f\u0443\u0441\u0430 \u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430","Can you pray for":"\u041c\u043e\u0436\u0435\u0448\u044c \u043b\u0438 \u0442\u044b \u043c\u043e\u043b\u0438\u0442\u044c\u0441\u044f \u0437\u0430",Cancel:"\u041e\u0442\u043c\u0435\u043d\u0430","Cancel study":"\u041e\u0442\u043c\u0435\u043d\u0438\u0442\u044c \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435","BibleDept is possible thanks to donations from people like you":"BibleDept \u0432\u043e\u0437\u043c\u043e\u0436\u0435\u043d \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f\u043c \u0442\u0430\u043a\u0438\u0445 \u043b\u044e\u0434\u0435\u0439, \u043a\u0430\u043a \u0432\u044b.",Casual:"\u041f\u043e\u0432\u0441\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0439","Celebrate with":"\u041f\u0440\u0430\u0437\u0434\u043d\u0443\u0439\u0442\u0435 \u0441","Celebrate with your group members":"\u041e\u0442\u043f\u0440\u0430\u0437\u0434\u043d\u0443\u0439\u0442\u0435 \u0441 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0430\u043c\u0438 \u0432\u0430\u0448\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u044b","Change Bible translation":"\u0418\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u0411\u0438\u0431\u043b\u0438\u0438","Change avatar":"\u0418\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0441\u0432\u043e\u0439 \u0430\u0432\u0430\u0442\u0430\u0440","Change conversation name":"\u0418\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0431\u0435\u0441\u0435\u0434\u044b","Change goal":"\u0418\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0446\u0435\u043b\u044c","Change group name":"\u0418\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0433\u0440\u0443\u043f\u043f\u044b","Change group picture":"\u0418\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0433\u0440\u0443\u043f\u043f\u044b","Change language":"\u0418\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u044f\u0437\u044b\u043a\u043e\u0432\u044b\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438","Change name":"\u0418\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0438\u043