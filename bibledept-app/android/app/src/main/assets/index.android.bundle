434\u0430\u043b\u0438\u0442\u0438 \u043f\u043b\u0430\u043d","Delete prayer":"\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u043c\u043e\u043b\u0438\u0442\u0432\u0443",Deleting:"\u0412\u0438\u0434\u0430\u043b\u0435\u043d\u043d\u044f...","Describe your group":"\u041e\u043f\u0438\u0448\u0456\u0442\u044c \u0441\u0432\u043e\u044e \u0433\u0440\u0443\u043f\u0443","Did you know that reading the Bible 4x a week leads to life change":"\ud83d\udca1 \u0427\u0438 \u0437\u043d\u0430\u0454\u0442\u0435 \u0432\u0438, \u0449\u043e \u0447\u0438\u0442\u0430\u043d\u043d\u044f \u0411\u0456\u0431\u043b\u0456\u0457 4 \u0440\u0430\u0437\u0438 \u043d\u0430 \u0442\u0438\u0436\u0434\u0435\u043d\u044c \u0437\u043c\u0456\u043d\u044e\u0454 \u0436\u0438\u0442\u0442\u044f?","Direct Messages":"\u041f\u0440\u044f\u043c\u0456 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f",Disable:"\u0412\u0438\u043c\u043a\u043d\u0443\u0442\u0438","Discipleship increases 231":"\u2b06\ufe0f \u0423\u0447\u043d\u0456\u0432\u0441\u0442\u0432\u043e \u0437\u0431\u0456\u043b\u044c\u0448\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u0430 231%",Discover:"\u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u0434\u043b\u044f \u0441\u0435\u0431\u0435",Discuss:"\u041e\u0431\u0433\u043e\u0432\u043e\u0440\u0456\u0442\u044c",Discussion:"\u041e\u0431\u0433\u043e\u0432\u043e\u0440\u0435\u043d\u043d\u044f","Discussion completed":"\u041e\u0431\u0433\u043e\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043e",Dismiss:"\u0412\u0456\u0434\u0445\u0438\u043b\u0438\u0442\u0438","Do not have group":"\u0443 \u043c\u0435\u043d\u0435 \u043d\u0435\u043c\u0430\u0454 \u0433\u0440\u0443\u043f\u0438","Do not worry we have got you":"\u043d\u0435 \u0445\u0432\u0438\u043b\u044e\u0439\u0441\u044f,\n\u0442\u0438 \u0432 \u043d\u0430\u0441!","Do you have a few minutes to celebrate with your group":"\u0423 \u0432\u0430\u0441 \u0454 \u043a\u0456\u043b\u044c\u043a\u0430 \u0445\u0432\u0438\u043b\u0438\u043d, \u0449\u043e\u0431 \u0432\u0456\u0434\u0441\u0432\u044f\u0442\u043a\u0443\u0432\u0430\u0442\u0438 \u0437\u0456 \u0441\u0432\u043e\u0454\u044e \u0433\u0440\u0443\u043f\u043e\u044e?","Do you have a few minutes to pray":"\u0423 \u0432\u0430\u0441 \u0454 \u043a\u0456\u043b\u044c\u043a\u0430 \u0445\u0432\u0438\u043b\u0438\u043d \u043d\u0430 \u043c\u043e\u043b\u0438\u0442\u0432\u0443?","Do you want to cancel this goal":"\u0412\u0438 \u0445\u043e\u0447\u0435\u0442\u0435 \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438 \u0446\u0435\u0439 \u0433\u043e\u043b?","Do you want to delete this goal":"\u0412\u0438 \u0431\u0430\u0436\u0430\u0454\u0442\u0435 \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0446\u044e \u0446\u0456\u043b\u044c?","Do you want to end this goal":"\u0412\u0438 \u0445\u043e\u0447\u0435\u0442\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438 \u0446\u044e \u043c\u0435\u0442\u0443?","Do you want to leave this goal":"\u0412\u0438 \u0445\u043e\u0447\u0435\u0442\u0435 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u0446\u044e \u0446\u0456\u043b\u044c?",Done:"\u0413\u043e\u0442\u043e\u0432\u043e","Dont worry only you can see these stats":"\u041d\u0435 \u0445\u0432\u0438\u043b\u044e\u0439\u0442\u0435\u0441\u044f, \u0446\u044e \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u043c\u043e\u0436\u0435\u0442\u0435 \u0431\u0430\u0447\u0438\u0442\u0438 \u043b\u0438\u0448\u0435 \u0432\u0438 \ud83d\udc4d",Downloading:"\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f ({{percent}}%)...","Downloading translation":"\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u043f\u0435\u0440\u0435\u043a\u043b\u0430\u0434\u0443...",Draft:"\u0427\u0435\u0440\u043d\u0435\u0442\u043a\u0430","Edit card info":"\u0420\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \u0434\u0430\u043d\u0456 \u043a\u0430\u0440\u0442\u043a\u0438","Edit day":"\u0420\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u