43a. \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0441\u0432\u0456\u0439 \u0444\u043e\u0440\u043c\u0430\u0442.\n\u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0411\u0443\u0442\u0442\u044f 1 \u0430\u0431\u043e \u0411\u0443\u0442\u0442\u044f 1:2-5, 9-12","question invalid":"\u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0432\u0432\u0435\u0434\u0456\u0442\u044c \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f",remove_fail:"\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0443\u0447\u0430\u0441\u043d\u0438\u043a\u0430!"},params:{"Chapter per day":{one:"1 \u0433\u043b\u0430\u0432\u0430 / \u0434\u0435\u043d\u044c",other:"{{countValue}} \u0440\u043e\u0437\u0434\u0456\u043b\u0456\u0432 \u043d\u0430 \u0434\u0435\u043d\u044c",zero:"-"},"Future plans reminder message":"\u0417\u0430\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f, {{nameValue}} \u043d\u0435 \u043f\u043b\u0430\u043d\u0443\u0454 \u043d\u0430\u0432\u0447\u0430\u0442\u0438\u0441\u044f \u043d\u0430 \u0437\u0430\u0432\u0442\u0440\u0430. \u0412\u0438\u0442\u0440\u0430\u0442\u044c\u0442\u0435 2 \u0445\u0432\u0438\u043b\u0438\u043d\u0438, \u0449\u043e\u0431 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u043e\u0434\u0438\u043d \u0437\u0430\u0440\u0430\u0437. \u23f0","Reminder message":"\u23f0 \u041d\u0430\u0441\u0442\u0430\u0432 \u0447\u0430\u0441 \u0449\u043e\u0434\u0435\u043d\u043d\u043e\u0433\u043e \u0447\u0438\u0442\u0430\u043d\u043d\u044f \u0411\u0456\u0431\u043b\u0456\u0457. \u041f\u0440\u0438\u0434\u0456\u043b\u0456\u0442\u044c 5 \u0445\u0432\u0438\u043b\u0438\u043d, \u0449\u043e\u0431 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438 \u0439\u043e\u0433\u043e.","Reminder title":"`\u041f\u0440\u0438\u0432\u0456\u0442, {{nameValue}}! \u0426\u0435 {{org_name}}.`","Sign in with":"\u0423\u0432\u0456\u0439\u0434\u0456\u0442\u044c \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e {{providerValue}}","Sign up with":"\u0417\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u0443\u0439\u0442\u0435\u0441\u044f \u0447\u0435\u0440\u0435\u0437 {{providerValue}}","Streak notification":"\u0412\u0438 \u043c\u0430\u0454\u0442\u0435 {{streakValue}}-\u0434\u0435\u043d\u043d\u0443 \u043f\u043e\u0441\u043f\u0456\u043b\u044c! \u041f\u0440\u0438\u0434\u0456\u043b\u0456\u0442\u044c 5 \u0445\u0432\u0438\u043b\u0438\u043d \u0437\u0430\u0440\u0430\u0437, \u0449\u043e\u0431 \u0437\u0440\u043e\u0431\u0438\u0442\u0438 \u0446\u0435 {{nextValue}}!","Streak warning notification":"\u0412\u0430\u0448\u0430 {{streakValue}}-\u0434\u0435\u043d\u043d\u0430 \u0441\u0435\u0440\u0456\u044f \u043f\u0456\u0434 \u0437\u0430\u0433\u0440\u043e\u0437\u043e\u044e! \u0412\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u0441\u0432\u043e\u044e \u0449\u043e\u0434\u0435\u043d\u043d\u0443 \u043c\u0435\u0442\u0443, \u0449\u043e\u0431 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0457\u0457.",chapter:"{{countChapter}} \u0440\u043e\u0437\u0434\u0456\u043b{{pluralS}}",replies:"{{valCount}} \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0435\u0439",reply:"{{valCount}} \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u044c",streaks:"{{currentStreak}}-\u0434\u0435\u043d\u043d\u0430 \u0441\u0435\u0440\u0456\u044f"},question:{"How are you moved to action from what you have read":"\u042f\u043a \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043d\u0435 \u0441\u043f\u043e\u043d\u0443\u043a\u0430\u0454 \u0432\u0430\u0441 \u0434\u043e \u0434\u0456\u0457?","How can you apply this to your life":"\u042f\u043a \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u0432\u0430\u0442\u0438 \u0446\u0435 \u0443 \u0441\u0432\u043e\u0454\u043c\u0443 \u0436\u0438\u0442\u0442\u0456? \ud83d\udc5f","How does this story speak to you personally":"\u042f\u043a \u0446\u044f \u0456\u0441\u0442\u043e\u0440\u0456\u044f \u0441\u0442\u043e\u0441\u0443\u0454\u0442\u044c\u0441\u044f \u0432\u0430\u0441 \u043e\u0441\u043e\u0431\u0438\u0441\u0442\u043e?","What 1 verse popped":"\u042f\u043a\u0438\u0439 1 \u0432\u0456\u0440\u0448 \u0432\u0438\u0441\u043a\u043e\u0447\u0438\u0432? \u26a1\ufe0f","What does this say about God or Jesus":"\u0429\u043e \u0446\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u043f\u0440\u043e \u0411\u043e\u0433\u0430 \u0447\u0438 \u0406\u0441\u0443\u0441\u0430?","What does this say about people":"\u0429\u043e \u0446\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u043f\u0440\u043e \u043b\u044e\u0434\u0435\u0439?","What one thing did you learn about Gods character":"\u0429\u043e \u0432\u0438 \u0434\u0456\u0437\u043d\u0430\u043b\u0438\u0441\u044f \u043f\u0440\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u0411\u043e\u0433\u0430? \u26a1\ufe0f","What passage stood out to you":"\u042f\u043a\u0438\u0439 \u0443\u0440\u0438\u0432\u043e\u043a \u0432\u0430\u043c \u0432\u043f\u0430\u0432 \u0443 \u0432\u0456\u0447\u0456? \ud83d\udcd6\ufe0f","Who can you share this with":"\u0417 \u043a\u0438\u043c \u0442\u0438 \u043c\u043e\u0436\u0435\u0448 \u043f\u043e\u0434\u0456\u043b\u0438\u0442\u0438\u0441\u044f \u0446\u0438\u043c? \ud83d\udcac"},streamI18n:{"1 Reply":"1 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u044c","1 Thread Reply":"1 \u0442\u0435\u043c\u0430 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456","Allow access to your Gallery":"\u0414\u043e\u0437\u0432\u043e\u043b\u044c\u0442\u0435 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0441\u0432\u043e\u0454\u0457 \u0433\u0430\u043b\u0435\u0440\u0435\u0457","Also send to channel":"\u0422\u0430\u043a\u043e\u0436 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u0438\u0442\u0438 \u043d\u0430 \u043a\u0430\u043d\u0430\u043b","Are you sure you want to permanently delete this message?":"\u0412\u0438 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0456, \u0449\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0446\u0435 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f?","Block User":"\u0417\u0430\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u0442\u0438 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430",Cancel:"\u0421\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438","Cannot Flag Message":"\u041d\u0435 \u0432\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u0435 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f","Copy Message":"\u041a\u043e\u043f\u0456\u044e\u0432\u0430\u0442\u0438 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f",Delete:"\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438","Delete Message":"\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f","Do you want to send a copy of this message to a moderator for further investigation?":"\u0412\u0438 \u0431\u0430\u0436\u0430\u0454\u0442\u0435 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u043a\u043e\u043f\u0456\u044e \u0446\u044c\u043e\u0433\u043e \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u043c\u043e\u0434\u0435\u0440\u0430\u0442\u043e\u0440\u0443 \u0434\u043b\u044f \u043f\u043e\u0434\u0430\u043b\u044c\u0448\u043e\u0433\u043e \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f?","Edit Message":"\u0420\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f","Editing Message":"\u0420\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f","Emoji matching":"\u0417\u0431\u0456\u0433 \u0435\u043c\u043e\u0434\u0437\u0456","Empty message...":"\u041f\u043e\u0440\u043e\u0436\u043d\u0454 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\