# Local development. Use false and fill the Web App config for a live project.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
# Leave empty to infer the computer address from Expo, or set your LAN IP.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
# Default suite: auth 9099, Firestore 8080, Functions 5001. For the isolated
# test suite use 19099, 18080, 15001 respectively (localhost browser only).
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
EXPO_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
EXPO_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional signed iPhone development build, not required for Expo Go.
BIBLEDEPT_NATIVE_PHONE=0
BIBLEDEPT_FIREBASE_IOS_CONFIG=
BIBLEDEPT_FIREBASE_ANDROID_CONFIG=
EXPO_PUBLIC_EAS_PROJECT_ID=
