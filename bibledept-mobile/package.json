{
  "name": "bibledept-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "expo": "~57.0.30",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-waveforms": "^0.1.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "firebase-tools": "^15.34.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go --lan",
    "android": "expo start --android",
    "ios": "expo start --go --lan",
    "web": "expo start --web --localhost",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "emulators": "npm --prefix functions run build && firebase emulators:start --project demo-bibledept --only auth,firestore,functions --export-on-exit=.firebase/data",
    "emulators:isolated": "npm --prefix functions run build && firebase emulators:start --config firebase.test.json --project demo-bibledept --only auth,firestore,functions",
    "test:emulators": "npm --prefix functions run build && firebase emulators:exec --config firebase.test.json --project demo-bibledept --only auth,firestore,functions \"npm run test:firebase && npm --prefix functions run test:integration\"",
    "test:firebase": "tsx --test tests/firebase.integration.ts",
    "start:development-build": "expo start --dev-client --lan"
  },
  "private": true
}
