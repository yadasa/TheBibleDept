{
  "name": "bibledept-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "expo": "~57.0.30",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "firebase-tools": "^15.34.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go --lan",
    "android": "expo start --android",
    "ios": "expo start --go --lan",
    "web": "expo start --web --localhost",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "emulators": "firebase emulators:start --project demo-bibledept --only auth,firestore --export-on-exit=.firebase/data",
    "test:firebase": "tsx --test tests/firebase.integration.ts",
    "start:development-build": "expo start --dev-client --lan"
  },
  "private": true
